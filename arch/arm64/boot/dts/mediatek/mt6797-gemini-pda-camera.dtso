/*
 * Planet Computers Gemini PDA camera sensors: power, master clocks and
 * identification only; there is no CSI-2 receiver yet.
 */

/dts-v1/;
/plugin/;

#include <dt-bindings/clock/mt6797-clk.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/mt6797-pinfunc.h>
#include <dt-bindings/power/mt6797-power.h>

/ {
	compatible = "planet,gemini-pda", "mediatek,mt6797";
};

&{/} {
	/* SENINF timing generators 0/1 provide CMMCLK0/1. */
	seninf_mclk: clock-controller@1a040000 {
		compatible = "mediatek,mt6797-seninf-mclk";
		reg = <0 0x1a040000 0 0x2000>;
		clocks = <&camsys CLK_CAM_CAMTG>,
			 <&camsys CLK_CAM_SENINF>,
			 <&camsys CLK_CAM_CAMSYS>;
		clock-names = "camtg", "seninf", "camsys";
		power-domains = <&scpsys MT6797_POWER_DOMAIN_ISP>;
		#clock-cells = <1>;
		assigned-clocks = <&topckgen CLK_TOP_MUX_CAMTG>;
		assigned-clock-parents = <&topckgen CLK_TOP_UNIVPLL_D26>;
	};
};

/*
 * Camera rails. The vendor DWS gives VCAMA, VCAMD and VCAMIO to the main
 * and sub camera only, default off; VLDO28 (camera AF) is shared with the
 * touch controller and is not used here.
 */
&mt6351regulator {
	mt6351_vcama_reg: ldo-vcama {
		regulator-name = "vcama";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
	};

	mt6351_vcamd_reg: ldo-vcamd {
		/* The vendor kernel raises the sensors' 1.2 V request to 1.21 V. */
		regulator-name = "vcamd";
		regulator-min-microvolt = <1210000>;
		regulator-max-microvolt = <1210000>;
	};

	mt6351_vcamio_reg: ldo-vcamio {
		regulator-name = "vcamio";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};
};


/*
 * Cameras. Both slots take the vendor-named "SP5509" module,
 * whose vendor driver matches the SK Hynix Hi-556 (chip ID 0x0556 at
 * register 0x0f16, and the same register programme). Wiring from the
 * vendor DWS and kd_camera_hw.c:
 *   main: I2C2, CMMCLK0 (GPIO30), reset GPIO32, powerdown GPIO28
 *   sub:  I2C3, CMMCLK1 (GPIO31), reset GPIO33, powerdown GPIO29
 * Rails: DOVDD VCAMIO 1.8 V, AVDD VCAMA 2.8 V, DVDD VCAMD 1.21 V, 24 MHz
 * MCLK, two CSI-2 data lanes. The vendor drivers probe both 8-bit
 * addresses 0x40 and 0x50 (7-bit 0x20/0x28): the main driver tries 0x50
 * first and the sub driver 0x40 first; those are the addresses used.
 * Which physical slot is populated varies by unit. There is no CSI-2
 * receiver yet, so the endpoints have no remote.
 */
&camsys {
	power-domains = <&scpsys MT6797_POWER_DOMAIN_ISP>;
	status = "okay";
};


&pio {
	camera_main_pins: camera-main-pins {
		pins-mclk {
			pinmux = <MT6797_GPIO30__FUNC_CMMCLK0>;
		};

		pins-ctrl {
			pinmux = <MT6797_GPIO32__FUNC_GPIO32>,
				 <MT6797_GPIO28__FUNC_GPIO28>;
		};
	};

	camera_sub_pins: camera-sub-pins {
		pins-mclk {
			pinmux = <MT6797_GPIO31__FUNC_CMMCLK1>;
		};

		pins-ctrl {
			pinmux = <MT6797_GPIO33__FUNC_GPIO33>,
				 <MT6797_GPIO29__FUNC_GPIO29>;
		};
	};
};

&i2c2 {
	#address-cells = <1>;
	#size-cells = <0>;
	/* The vendor DWS runs this bus at 300 kHz. */
	clock-frequency = <300000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_pins_a>;
	status = "okay";

	camera_main: camera@28 {
		compatible = "hynix,hi556";
		reg = <0x28>;
		pinctrl-names = "default";
		pinctrl-0 = <&camera_main_pins>;
		clocks = <&seninf_mclk 0>;
		assigned-clocks = <&seninf_mclk 0>;
		assigned-clock-rates = <24000000>;
		dovdd-supply = <&mt6351_vcamio_reg>;
		avdd-supply = <&mt6351_vcama_reg>;
		dvdd-supply = <&mt6351_vcamd_reg>;
		reset-gpios = <&pio 32 GPIO_ACTIVE_LOW>;
		powerdown-gpios = <&pio 28 GPIO_ACTIVE_LOW>;

		port {
			endpoint {
				data-lanes = <1 2>;
			};
		};
	};
};

&i2c3 {
	#address-cells = <1>;
	#size-cells = <0>;
	camera_sub: camera@20 {
		compatible = "hynix,hi556";
		reg = <0x20>;
		pinctrl-names = "default";
		pinctrl-0 = <&camera_sub_pins>;
		clocks = <&seninf_mclk 1>;
		assigned-clocks = <&seninf_mclk 1>;
		assigned-clock-rates = <24000000>;
		dovdd-supply = <&mt6351_vcamio_reg>;
		avdd-supply = <&mt6351_vcama_reg>;
		dvdd-supply = <&mt6351_vcamd_reg>;
		reset-gpios = <&pio 33 GPIO_ACTIVE_LOW>;
		powerdown-gpios = <&pio 29 GPIO_ACTIVE_LOW>;

		port {
			endpoint {
				data-lanes = <1 2>;
			};
		};
	};
};
