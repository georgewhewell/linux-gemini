// SPDX-License-Identifier: GPL-2.0-only
/*
 * Planet Computers Gemini PDA GPU probe-only preflight overlay.
 *
 * Apply this overlay only to a recoverable RAM boot and run
 * tools/gemini/capture-gpu-preflight.sh without opening a render node. The
 * base DT keeps every node below disabled, so omitting the overlay is the
 * complete rollback.
 */

/dts-v1/;
/plugin/;

/ {
	compatible = "planet,gemini-pda", "mediatek,mt6797";
};

&i2c7 {
	status = "okay";
};

&rt5735_vgpu {
	status = "okay";
};

&mfgsys {
	status = "okay";
};

&gpu {
	status = "okay";
};
