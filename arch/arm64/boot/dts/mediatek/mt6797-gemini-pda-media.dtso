/*
 * Planet Computers Gemini PDA multimedia IOMMU and JPEG codec.
 *
 * Enables the MT6797 M4U, which translates the display (larb0 and larb5,
 * enabled by the display overlay) and larb3 for the JPEG encoder and decoder
 * in the VENC power domain.
 */

/dts-v1/;
/plugin/;

#include <dt-bindings/power/mt6797-power.h>

&m4u {
	status = "okay";
};

/* VENC_CG is only accessible with the VENC power domain on. */
&vencsys {
	power-domains = <&scpsys MT6797_POWER_DOMAIN_VENC>;
};

&larb3 {
	status = "okay";
};

&jpeg_encoder {
	status = "okay";
};

&jpeg_decoder {
	status = "okay";
};
