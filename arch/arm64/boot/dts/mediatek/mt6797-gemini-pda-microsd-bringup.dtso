// SPDX-License-Identifier: GPL-2.0-only
/*
 * Planet Computers Gemini PDA MicroSD (MSDC1) 3.0 V bring-up overlay.
 *
 * This is deliberately an opt-in enumeration experiment.  The base Gemini
 * DT leaves MMC1 disabled.  Applying this overlay enables only a 4-bit,
 * 400 kHz SD path.  In particular it does not advertise an SD high-speed or
 * UHS mode, and it constrains both card power (VMCH) and signalling power
 * (VMC) to 3.0 V.  That prevents the VMC 1.8 V level-switch path until its
 * pad settings and tuning contract are recovered on mainline.
 *
 * Vendor MT6797 evidence, all from the Gemini 3.18 source:
 *
 * - arch/arm64/boot/dts/aeon6797_6m_n.dts:748-771 enables MMC1 as a
 *   4-bit MSDC_SD host, names GPIO67 as card-detect and gives CD_HIGH.
 * - The same file:775-783 muxes GPIO67 to EINT6 for the insertion switch.
 * - drivers/mmc/host/mediatek/mt6797/msdc_io.c:296-312 makes VMCH the
 *   MMC1 card rail and VMC the I/O rail, both at 3.0 V.
 * - The same file:199-220 changes only VMC to 1.8 V for UHS.  No UHS
 *   capability is therefore present here.
 *
 * Mainline evidence:
 *
 * - mt6797.dtsi:831-839 describes the compatible controller at 0x11240000.
 * - include/dt-bindings/pinctrl/mt6797-pinfunc.h:388-389 and :709-742 map
 *   GPIO67 to EINT6 and GPIO129..134 to the six MSDC1 signals.
 * - Documentation/devicetree/bindings/mmc/mtk-sd.yaml:168-179 requires the
 *   two pin states and both supplies.  mtk-sd.c:2163-2191 sequences them.
 * - drivers/regulator/mt6351-regulator.c:112-114,140-143,285-288,322-323
 *   establishes VMCH's 3.0/3.3 V choices and VMC's selectable voltages.
 *
 * The current MT6797 pinctrl descriptor has no pull, input-enable, or drive
 * field maps (pinctrl-mt6797.c:23-44), so this overlay supplies mux only and
 * deliberately leaves the vendor's drive strengths and UHS tuning untouched.
 */

/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/mt6797-pinfunc.h>

&mt6351regulator {
	/* Vendor MMC1 card rail: VMCH, constrained to its 3.0 V mode. */
	mt6351_vmch_reg: ldo-vmch {
		regulator-name = "vmch";
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3000000>;
	};

	/* Vendor MMC1 signalling rail: VMC, kept out of the 1.8 V UHS mode. */
	mt6351_vmc_reg: ldo-vmc {
		regulator-name = "vmc";
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3000000>;
	};
};

&pio {
	microsd_mmc1_pins: microsd-mmc1-pins {
		pins-cmd-dat {
			pinmux = <MT6797_GPIO129__FUNC_MSDC1_CMD>,
				 <MT6797_GPIO130__FUNC_MSDC1_DAT0>,
				 <MT6797_GPIO131__FUNC_MSDC1_DAT1>,
				 <MT6797_GPIO132__FUNC_MSDC1_DAT2>,
				 <MT6797_GPIO133__FUNC_MSDC1_DAT3>;
		};

		pins-clk {
			pinmux = <MT6797_GPIO134__FUNC_MSDC1_CLK>;
		};
	};

	microsd_cd_pin: microsd-cd-pin {
		/* Vendor MMC1 insertion switch: GPIO67 / EINT6. */
		pins-cd {
			pinmux = <MT6797_GPIO67__FUNC_EINT6>;
		};
	};
};

&mmc1 {
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&microsd_mmc1_pins &microsd_cd_pin>;
	/* No electrical UHS transition is permitted; retain the 3.0 V state. */
	pinctrl-1 = <&microsd_mmc1_pins &microsd_cd_pin>;

	bus-width = <4>;
	max-frequency = <400000>;
	cd-gpios = <&pio 67 GPIO_ACTIVE_HIGH>;
	vmmc-supply = <&mt6351_vmch_reg>;
	vqmmc-supply = <&mt6351_vmc_reg>;
	status = "okay";
};
