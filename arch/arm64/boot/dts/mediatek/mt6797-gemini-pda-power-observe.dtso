/*
 * Planet Computers Gemini PDA BQ2589x charger observation candidate.
 *
 * The vendor Gemini configuration selects CONFIG_MTK_BQ25896_SUPPORT and its
 * MT6797 BQ driver uses the 7-bit address 0x6b. The vendor DT, however, does
 * not identify the physical I2C controller or the IRQ wiring. The legacy
 * driver's non-DT fallback nominally used logical adapter 0, which is not
 * proof of board routing. Keep both this node and its parent controller
 * disabled until that route is established on a recoverable image.
 */

/dts-v1/;
/plugin/;

/ {
	compatible = "planet,gemini-pda", "mediatek,mt6797";
};

&i2c0 {
	#address-cells = <1>;
	#size-cells = <0>;

	bq25896_observe: charger@6b {
		compatible = "ti,bq25896", "ti,bq25890";
		reg = <0x6b>;
		ti,read-only;
		status = "disabled";
	};
};
