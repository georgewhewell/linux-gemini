/*
 * Explicit volatile activation gate for the canonical MT6797 WLAN endpoint.
 * The endpoint boots verified firmware, performs the bounded capability and
 * basic-config exchanges, then leaves its IRQ and network interfaces disabled.
 */
/dts-v1/;
/plugin/;

&consys_emi_mpu {
	status = "okay";
};

&btif {
	status = "okay";
};

&consys {
	status = "okay";
};

&wifi {
	status = "okay";
};
