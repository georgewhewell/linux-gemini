/dts-v1/;

#include "mt6797.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	model = "Planet Computers Gemini PDA";
	chassis-type = "handset";
	compatible = "planet,gemini-pda", "mediatek,mt6797";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:921600n8";
	};

	consys: consys@18070000 {
		compatible = "mediatek,mt6797-consys-runtime";
		reg = <0 0x18070000 0 0x200>,
		      <0 0x10007000 0 0x100>,
		      <0 0x10000000 0 0x2000>,
		      <0 0x10006000 0 0x1000>,
		      <0 0x180b6000 0 0x100>;
		reg-names = "mcu", "ap-rgu", "topckgen", "spm", "afe";
		interrupts = <GIC_SPI 284 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_SPI 285 IRQ_TYPE_LEVEL_LOW>;
		interrupt-names = "bgf", "wdt";
		resets = <&watchdog MT6797_TOPRGU_CONMCU_SW_RST>;
		reset-names = "conn-mcu";
		mediatek,conn-power-domain = <&scpsys MT6797_POWER_DOMAIN_CONN>;
		mediatek,infracfg = <&infrasys>;
		mediatek,spm = <&scpsys>;
		vcn18-supply = <&mt6351_vcn18_reg>;
		vcn28-supply = <&mt6351_vcn28_reg>;
		memory-region = <&consys_reserved_memory>;
		memory-region-names = "shared";
		status = "okay";
	};

	consys_emi_mpu: emi-mpu@10203000 {
		compatible = "mediatek,mt6797-consys-emi-mpu";
		reg = <0 0x10203000 0 0x1000>,
		      <0 0x10000000 0 0x2000>;
		reg-names = "emi", "topckgen";
		memory-region = <&consys_reserved_memory>;
		memory-region-names = "shared";
		status = "okay";
	};

	consys_controller: consys-controller {
		compatible = "mediatek,mt6797-consys-runtime-controller";
		mediatek,runtime-provider = <&consys>;
		mediatek,btif-provider = <&btif>;
		status = "okay";
	};

	wifi: wifi@180f0000 {
		compatible = "mediatek,mt6797-wifi";
		reg = <0 0x180f0000 0 0x1100>;
		interrupts = <GIC_SPI 283 IRQ_TYPE_LEVEL_LOW>;
		interrupt-names = "wifi";
		mediatek,runtime-provider = <&consys>;
		mediatek,controller = <&consys_controller>;
		mediatek,emi-mpu = <&consys_emi_mpu>;
		bt-paldo-supply = <&mt6351_vcn33_bt_reg>;
		wifi-paldo-supply = <&mt6351_vcn33_wifi_reg>;
		status = "okay";
	};

	usb11_drvvbus: regulator-usb11-drvvbus {
		compatible = "regulator-fixed";
		regulator-name = "usb11-drvvbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&pio 94 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	usb11_vbus: regulator-usb11-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb11-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&pio 72 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		vin-supply = <&usb11_drvvbus>;
	};

	firmware {
		mt6797_atag_devinfo: atag-devinfo {
			compatible = "mediatek,mt6797-atag-devinfo";
			#address-cells = <1>;
			#size-cells = <1>;
			read-only;

			mt6797_thermal_calibration: calibration-data@0 {
				reg = <0 12>;
			};

			mt6797_csi_calibration: csi-calibration-data@64 {
				reg = <100 20>;
			};
		};
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0 0x40000000 1 0>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		memory@40000000 {
			reg = <0 0x40000000 0 0x1000>;
			no-map;
		};

		memory@44400000 {
			reg = <0 0x44400000 0 0x10000>;
			no-map;
		};

		ramoops@44410000 {
			compatible = "ramoops";
			reg = <0 0x44410000 0 0xe0000>;
			record-size = <0x1000>;
			console-size = <0x10000>;
			ftrace-size = <0x1000>;
			pmsg-size = <0x20000>;
			mem-type = <0>;
			no-map;
		};

		memory@444f0000 {
			reg = <0 0x444f0000 0 0x10000>;
			no-map;
		};

		memory@44600000 {
			reg = <0 0x44600000 0 0x10000>;
			no-map;
		};

		memory@44610000 {
			reg = <0 0x44610000 0 0x30000>;
			no-map;
		};

		memory@44640000 {
			reg = <0 0x44640000 0 0x30000>;
			no-map;
		};

		memory@44800000 {
			reg = <0 0x44800000 0 0x100000>;
			no-map;
		};

		memory@46000000 {
			reg = <0 0x46000000 0 0x400000>;
			no-map;
		};

		reserve-memory-ccci_md1 {
			compatible = "mediatek,reserve-memory-ccci_md1";
			no-map;
			size = <0 0xa100000>;
			alignment = <0 0x2000000>;
			alloc-ranges = <0 0x40000000 0 0x80000000>;
		};

		reserve-memory-ccci_share {
			compatible = "mediatek,reserve-memory-ccci_share";
			no-map;
			size = <0 0x600000>;
			alignment = <0 0x4000000>;
			alloc-ranges = <0 0x40000000 0 0x50000000>;
		};

		consys_reserved_memory: consys-reserve-memory {
			compatible = "mediatek,consys-reserve-memory";
			no-map;
			size = <0 0x200000>;
			alignment = <0 0x200000>;
			alloc-ranges = <0 0x40000000 0 0x80000000>;
		};

		spm-reserve-memory {
			compatible = "mediatek,spm-reserve-memory";
			no-map;
			size = <0 0x16000>;
			alignment = <0 0x10000>;
			alloc-ranges = <0 0x40000000 0 0x80000000>;
		};

		reserve-memory-scp_share {
			compatible = "mediatek,reserve-memory-scp_share";
			no-map;
			size = <0 0x1000000>;
			alignment = <0 0x1000000>;
			alloc-ranges = <0 0x40000000 0 0x50000000>;
		};
	};
};

&cpu8 {
	enable-method = "mediatek,mt6797-a72-psci";
};

&cpu9 {
	enable-method = "mediatek,mt6797-a72-psci";
};

&a72_power {
	status = "okay";
	vproc-supply = <&da9214_buckb>;
};

/*
 * LK leaves the MT6351 FGADC configured with the vendor board calibration.
 * Linux takes ownership of coherent current and coulomb-counter sampling, but
 * does not infer capacity, voltage, or charger policy from those readings.
 */
&mt6351fg {
	status = "disabled";
};

&mt6351fgadc {
	status = "okay";
	mediatek,initialize-fgadc;
	mediatek,fgadc-init-control = <0x28>;
	mediatek,fgadc-osr = <8>;
	mediatek,fg-resistance-milliohm = <10>;
	mediatek,fg-board-base = <1000>;
	mediatek,fg-board-slope = <1000>;
	mediatek,car-tune = <118>;
	mediatek,fg-trim-permille = <1000>;
};

&mt6351regulator {
	mt6351_vcn18_reg: ldo-vcn18 {
		regulator-name = "vcn18";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};

	mt6351_vcn28_reg: ldo-vcn28 {
		regulator-name = "vcn28";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
	};

	mt6351_vcn33_bt_reg: ldo-vcn33-bt {
		regulator-name = "vcn33-bt";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3600000>;
	};

	mt6351_vcn33_wifi_reg: ldo-vcn33-wifi {
		regulator-name = "vcn33-wifi";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3600000>;
	};

	mt6351_vemc_reg: ldo-vemc {
		regulator-name = "vemc_3v3";
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
	};

	mt6351_vio18_reg: ldo-vio18 {
		regulator-name = "vio18";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	mt6351_vcama_reg: ldo-vcama {
		regulator-name = "vcama_2v8";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
	};

	mt6351_vcamd_reg: ldo-vcamd {
		regulator-name = "vcamd_1v2";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
	};

	mt6351_vcamio_reg: ldo-vcamio {
		regulator-name = "vcamio_1v8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};
};

&btif {
	compatible = "mediatek,mt6797-btif-pio";
	reg = <0 0x1100c000 0 0x1000>;
	interrupts = <GIC_SPI 130 IRQ_TYPE_LEVEL_LOW>;
	clocks = <&infrasys CLK_INFRA_BTIF>;
	clock-names = "btifc";
	/delete-property/ reg-shift;
	/delete-property/ reg-io-width;
	status = "okay";
};

&pio {
	/*
	 * MT6797 pinctrl currently supports pinmux only for these pads:
	 * its descriptor has no pull, IES, or drive-strength register maps.
	 * Keep boot-firmware pad configuration until those maps are recovered.
	 */
	uart0_gemini_pins: uart0-gemini-pins {
		pins-rx-tx {
			pinmux = <MT6797_GPIO97__FUNC_URXD0>,
				 <MT6797_GPIO98__FUNC_UTXD0>;
		};
	};

	camera1_pins: camera1-pins {
		pins-mclk {
			pinmux = <MT6797_GPIO31__FUNC_CMMCLK1>;
		};

		pins-control {
			pinmux = <MT6797_GPIO33__FUNC_GPIO33>,
				 <MT6797_GPIO29__FUNC_GPIO29>;
		};
	};

	mmc0_pins_default: mmc0-default-pins {
		pins-cmd-dat {
			pinmux = <MT6797_GPIO114__FUNC_MSDC0_DAT0>,
				 <MT6797_GPIO115__FUNC_MSDC0_DAT1>,
				 <MT6797_GPIO116__FUNC_MSDC0_DAT2>,
				 <MT6797_GPIO117__FUNC_MSDC0_DAT3>,
				 <MT6797_GPIO118__FUNC_MSDC0_DAT4>,
				 <MT6797_GPIO119__FUNC_MSDC0_DAT5>,
				 <MT6797_GPIO120__FUNC_MSDC0_DAT6>,
				 <MT6797_GPIO121__FUNC_MSDC0_DAT7>,
				 <MT6797_GPIO122__FUNC_MSDC0_CMD>;
		};

		pins-clk {
			pinmux = <MT6797_GPIO123__FUNC_MSDC0_CLK>;
		};

		pins-ds {
			pinmux = <MT6797_GPIO124__FUNC_MSDC0_DSL>;
		};

		pins-rst {
			pinmux = <MT6797_GPIO125__FUNC_MSDC0_RSTB>;
		};
	};

	hall_pins: hall-pins {
		pins-hall {
			pinmux = <MT6797_GPIO66__FUNC_GPIO66>;
		};
	};

	usb11_fusb301a_pins: usb11-fusb301a-pins {
		pins-attach {
			pinmux = <MT6797_GPIO64__FUNC_EINT3>;
		};

		pins-data-mux-enable {
			pinmux = <MT6797_GPIO70__FUNC_GPIO70>;
			output-high;
		};

		pins-data-mux-select {
			pinmux = <MT6797_GPIO71__FUNC_GPIO71>;
			output-low;
		};
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_gemini_pins>;
	status = "okay";
};

&mmc0 {
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins_default>;
	pinctrl-1 = <&mmc0_pins_default>;
	bus-width = <8>;
	max-frequency = <25000000>;
	vmmc-supply = <&mt6351_vemc_reg>;
	vqmmc-supply = <&mt6351_vio18_reg>;
	non-removable;
	no-sd;
	no-sdio;
	status = "okay";
};

&i2c6 {
	clock-frequency = <3400000>;
	mediatek,use-push-pull;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c6_pins_a>;
	status = "okay";

	da9214: regulator@68 {
		compatible = "dlg,da9214";
		reg = <0x68>;

		regulators {
			da9214_bucka: BUCKA {
				regulator-name = "da9214-bucka";
			};

			da9214_buckb: BUCKB {
				regulator-name = "vproc-big";
			};
		};
	};
};

&i2c7 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c7_pins_a>;
	status = "okay";

	/*
	 * Live Gemian identifies the external GPU buck as RT5735 at 0x1c.
	 * Hold its first mainline operating point at a fixed 975 mV.
	 */
	rt5735_vgpu: regulator@1c {
		compatible = "richtek,rt5735";
		reg = <0x1c>;
		regulator-name = "vgpu";
		regulator-min-microvolt = <975000>;
		regulator-max-microvolt = <975000>;
		regulator-boot-on;
		status = "okay";
	};
};

&i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pins_a>;
	status = "okay";

	lcd_bias: regulator@3e {
		compatible = "mediatek,i2c_lcd_bias";
		reg = <0x3e>;

		outp: outp {
			regulator-name = "outp";
			enable-gpios = <&pio 60 GPIO_ACTIVE_HIGH>;
		};

		outn: outn {
			regulator-name = "outn";
			enable-gpios = <&pio 251 GPIO_ACTIVE_HIGH>;
		};
	};

	/*
	 * Keep this candidate disabled until the physical ID, rails, and
	 * interrupt/polling contract are verified on a recoverable image.
	 * The vendor's logical 0x68 client is rewritten to 0x69 in probe.
	 */
	bmi160_candidate: bmi160@69 {
		compatible = "bosch,bmi160";
		reg = <0x69>;
		mount-matrix = "0", "-1", "0",
				       "-1", "0", "0",
				       "0", "0", "-1";
		status = "disabled";
	};
};

/*
 * The populated SLS camera1 module is intentionally disabled with its bus.
 * Enabling the complete candidate requires i2c3, sp5509, larb2, seninf and
 * camsv0 together; no partial route is safe or useful.
 */
&i2c3 {
	clock-frequency = <300000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3_pins_a>;

	sp5509: camera@20 {
		compatible = "siliconfile,sp5509";
		reg = <0x20>;
		clocks = <&seninf>;
		clock-names = "clk";
		pinctrl-names = "default";
		pinctrl-0 = <&camera1_pins>;
		dovdd-supply = <&mt6351_vcamio_reg>;
		avdd-supply = <&mt6351_vcama_reg>;
		dvdd-supply = <&mt6351_vcamd_reg>;
		reset-gpios = <&pio 33 GPIO_ACTIVE_LOW>;
		powerdown-gpios = <&pio 29 GPIO_ACTIVE_LOW>;
		status = "disabled";

		port {
			sp5509_out: endpoint {
				remote-endpoint = <&seninf_sub_in>;
				data-lanes = <1 2>;
				link-frequencies = /bits/ 64 <440000000
							       220000000
							       110000000>;
			};
		};
	};
};

&watchdog {
	interrupts = <GIC_SPI 137 IRQ_TYPE_EDGE_FALLING>;
};

&pio {
	keyboard_soc_pins: keyboard-soc-pins {
		pins-reset {
			pinmux = <MT6797_GPIO58__FUNC_GPIO58>;
			output-high;
		};

		pins-irq {
			pinmux = <MT6797_GPIO87__FUNC_EINT10>;
		};
	};
};

&i2c5 {
	/* The hardware-proven keyboard path uses the AW9523 at 400 kHz. */
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c5_pins_a>;
	status = "okay";

	aw9523: gpio-expander@5b {
		compatible = "awinic,aw9523-pinctrl";
		reg = <0x5b>;
		pinctrl-names = "default";
		pinctrl-0 = <&keyboard_soc_pins>;
		gpio-controller;
		#gpio-cells = <2>;
		gpio-ranges = <&aw9523 0 0 16>;
		reset-gpios = <&pio 58 GPIO_ACTIVE_HIGH>;
		status = "okay";

		keyboard_matrix_row_pins: keyboard-matrix-row-pins {
			pins = "gpio0", "gpio1", "gpio2", "gpio3",
			       "gpio4", "gpio5", "gpio6", "gpio7";
			function = "gpio";
			bias-pull-up;
			drive-open-drain;
			input-enable;
		};

		keyboard_matrix_col_pins: keyboard-matrix-col-pins {
			pins = "gpio8", "gpio9", "gpio10", "gpio11",
			       "gpio12", "gpio13", "gpio14";
			function = "gpio";
			input-disable;
			output-low;
		};
	};
};

&{/} {
	keyboard-matrix {
		compatible = "gpio-matrix-keypad";
		pinctrl-names = "default";
		gpio-activelow;
		drive-inactive-cols;
		pinctrl-0 = <&keyboard_matrix_row_pins
				     &keyboard_matrix_col_pins>;
		row-gpios = <&aw9523 0 GPIO_ACTIVE_HIGH>,
			    <&aw9523 1 GPIO_ACTIVE_HIGH>,
			    <&aw9523 2 GPIO_ACTIVE_HIGH>,
			    <&aw9523 3 GPIO_ACTIVE_HIGH>,
			    <&aw9523 4 GPIO_ACTIVE_HIGH>,
			    <&aw9523 5 GPIO_ACTIVE_HIGH>,
			    <&aw9523 6 GPIO_ACTIVE_HIGH>,
			    <&aw9523 7 GPIO_ACTIVE_HIGH>;
		col-gpios = <&aw9523 8 GPIO_ACTIVE_HIGH>,
			    <&aw9523 9 GPIO_ACTIVE_HIGH>,
			    <&aw9523 10 GPIO_ACTIVE_HIGH>,
			    <&aw9523 11 GPIO_ACTIVE_HIGH>,
			    <&aw9523 12 GPIO_ACTIVE_HIGH>,
			    <&aw9523 13 GPIO_ACTIVE_HIGH>,
			    <&aw9523 14 GPIO_ACTIVE_HIGH>;
		linux,keymap = <
			MATRIX_KEY(0, 0, KEY_1)
			MATRIX_KEY(1, 0, KEY_U)
			MATRIX_KEY(2, 0, KEY_S)
			MATRIX_KEY(3, 0, KEY_Z)
			MATRIX_KEY(4, 0, KEY_COMMA)
			MATRIX_KEY(5, 0, KEY_APOSTROPHE)
			MATRIX_KEY(6, 0, KEY_8)
			MATRIX_KEY(7, 0, KEY_J)
			MATRIX_KEY(0, 1, KEY_2)
			MATRIX_KEY(1, 1, KEY_W)
			MATRIX_KEY(2, 1, KEY_D)
			MATRIX_KEY(3, 1, KEY_C)
			MATRIX_KEY(4, 1, KEY_LEFTALT)
			MATRIX_KEY(5, 1, KEY_LEFT)
			MATRIX_KEY(6, 1, KEY_9)
			MATRIX_KEY(7, 1, KEY_K)
			MATRIX_KEY(0, 2, KEY_3)
			MATRIX_KEY(1, 2, KEY_Y)
			MATRIX_KEY(2, 2, KEY_TAB)
			MATRIX_KEY(3, 2, KEY_N)
			MATRIX_KEY(4, 2, KEY_M)
			MATRIX_KEY(5, 2, KEY_DOWN)
			MATRIX_KEY(6, 2, KEY_BACKSPACE)
			MATRIX_KEY(7, 2, KEY_I)
			MATRIX_KEY(0, 3, KEY_4)
			MATRIX_KEY(1, 3, KEY_T)
			MATRIX_KEY(2, 3, KEY_F)
			MATRIX_KEY(3, 3, KEY_X)
			MATRIX_KEY(4, 3, KEY_LEFTMETA)
			MATRIX_KEY(5, 3, KEY_RIGHTSHIFT)
			MATRIX_KEY(6, 3, KEY_P)
			MATRIX_KEY(0, 4, KEY_5)
			MATRIX_KEY(1, 4, KEY_E)
			MATRIX_KEY(2, 4, KEY_G)
			MATRIX_KEY(3, 4, KEY_V)
			MATRIX_KEY(4, 4, KEY_SPACE)
			MATRIX_KEY(5, 4, KEY_UP)
			MATRIX_KEY(6, 4, KEY_O)
			MATRIX_KEY(0, 5, KEY_6)
			MATRIX_KEY(1, 5, KEY_Q)
			MATRIX_KEY(2, 5, KEY_A)
			MATRIX_KEY(3, 5, KEY_B)
			MATRIX_KEY(4, 5, KEY_DOT)
			MATRIX_KEY(5, 5, KEY_RIGHT)
			MATRIX_KEY(6, 5, KEY_ENTER)
			MATRIX_KEY(0, 6, KEY_7)
			MATRIX_KEY(1, 6, KEY_R)
			MATRIX_KEY(2, 6, KEY_H)
			MATRIX_KEY(3, 6, KEY_LEFTSHIFT)
			MATRIX_KEY(4, 6, KEY_LEFTCTRL)
			MATRIX_KEY(5, 6, KEY_L)
			MATRIX_KEY(6, 6, KEY_0)>;
		poll-interval = <20>;
		col-scan-delay-us = <2>;
		status = "okay";
	};
};

&mipi_tx0 {
	status = "okay";
};

&m4u {
	status = "okay";
};

&smi_common {
	status = "okay";
};

&larb0 {
	status = "okay";
};

&larb5 {
	status = "okay";
};

&mmsys {
	port {
		#address-cells = <1>;
		#size-cells = <0>;

		gemini_mmsys_out: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&gemini_ovl0_2l_in>;
		};
	};
};

&ovl0_2l {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			gemini_ovl0_2l_in: endpoint {
				remote-endpoint = <&gemini_mmsys_out>;
			};
		};

		port@1 {
			reg = <1>;

			gemini_ovl0_2l_out: endpoint {
				remote-endpoint = <&gemini_ovl1_2l_in>;
			};
		};
	};
};

&ovl1_2l {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			gemini_ovl1_2l_in: endpoint {
				remote-endpoint = <&gemini_ovl0_2l_out>;
			};
		};

		port@1 {
			reg = <1>;

			gemini_ovl1_2l_out: endpoint {
				remote-endpoint = <&gemini_color0_in>;
			};
		};
	};
};

&color0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			gemini_color0_in: endpoint {
				remote-endpoint = <&gemini_ovl1_2l_out>;
			};
		};

		port@1 {
			reg = <1>;

			gemini_color0_out: endpoint {
				remote-endpoint = <&gemini_ccorr0_in>;
			};
		};
	};
};

&ccorr0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			gemini_ccorr0_in: endpoint {
				remote-endpoint = <&gemini_color0_out>;
			};
		};

		port@1 {
			reg = <1>;

			gemini_ccorr0_out: endpoint {
				remote-endpoint = <&gemini_aal0_in>;
			};
		};
	};
};

&aal0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			gemini_aal0_in: endpoint {
				remote-endpoint = <&gemini_ccorr0_out>;
			};
		};

		port@1 {
			reg = <1>;

			gemini_aal0_out: endpoint {
				remote-endpoint = <&gemini_gamma0_in>;
			};
		};
	};
};

&gamma0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			gemini_gamma0_in: endpoint {
				remote-endpoint = <&gemini_aal0_out>;
			};
		};

		port@1 {
			reg = <1>;

			gemini_gamma0_out: endpoint {
				remote-endpoint = <&gemini_od0_in>;
			};
		};
	};
};

&od0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			gemini_od0_in: endpoint {
				remote-endpoint = <&gemini_gamma0_out>;
			};
		};

		port@1 {
			reg = <1>;

			gemini_od0_out: endpoint {
				remote-endpoint = <&gemini_dither0_in>;
			};
		};
	};
};

&dither0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			gemini_dither0_in: endpoint {
				remote-endpoint = <&gemini_od0_out>;
			};
		};

		port@1 {
			reg = <1>;

			gemini_dither0_out: endpoint {
				remote-endpoint = <&gemini_rdma0_in>;
			};
		};
	};
};

&rdma0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			gemini_rdma0_in: endpoint {
				remote-endpoint = <&gemini_dither0_out>;
			};
		};

		port@1 {
			reg = <1>;

			gemini_rdma0_out: endpoint {
				remote-endpoint = <&gemini_ufoe_in>;
			};
		};
	};
};

&ufoe {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			gemini_ufoe_in: endpoint {
				remote-endpoint = <&gemini_rdma0_out>;
			};
		};

		port@1 {
			reg = <1>;

			gemini_ufoe_out: endpoint {
				remote-endpoint = <&gemini_dsi0_in>;
			};
		};
	};
};

&dsi0 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	panel@0 {
		compatible = "planet,gemini-pda-nt36672";
		reg = <0>;
		outp-supply = <&outp>;
		outn-supply = <&outn>;
		reset-gpios = <&pio 180 GPIO_ACTIVE_HIGH>;

		port {
			gemini_panel_in: endpoint {
				remote-endpoint = <&gemini_dsi0_out>;
			};
		};
	};
};

&dsi0_in {
	gemini_dsi0_in: endpoint {
		remote-endpoint = <&gemini_ufoe_out>;
	};
};

&dsi0_out {
	gemini_dsi0_out: endpoint {
		remote-endpoint = <&gemini_panel_in>;
	};
};

/* The left USB-C connector is the hardware-proven MTU3 peripheral path. */
&u3phy {
	status = "okay";
};

&u2port0 {
	clocks = <&clk26m>;
	mediatek,force-b-session-valid;
	status = "okay";
};

&ssusb {
	assigned-clocks = <&topckgen CLK_TOP_MUX_SSUSB_TOP_SYS>;
	assigned-clock-parents = <&topckgen CLK_TOP_UNIVPLL3_D2>;
	phys = <&u2port0 PHY_TYPE_USB2>;
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
	status = "okay";
};

&thermal {
	nvmem-cells = <&mt6797_thermal_calibration>;
	nvmem-cell-names = "calibration-data";
};

&seninf {
	nvmem-cells = <&mt6797_csi_calibration>;
	nvmem-cell-names = "csi-calibration-data";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			seninf_sub_in: endpoint {
				remote-endpoint = <&sp5509_out>;
				bus-type = <4>;
				data-lanes = <1 2>;
			};
		};

		port@1 {
			reg = <1>;

			seninf_sub_out: endpoint {
				remote-endpoint = <&camsv0_in>;
			};
		};
	};
};

&camsv0_in {
	remote-endpoint = <&seninf_sub_out>;
};
&i2c0 {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pins_a>;
	status = "okay";

	fusb301a: typec@25 {
		compatible = "onsemi,fusb301a";
		reg = <0x25>;
		interrupt-parent = <&pio>;
		interrupts = <3 IRQ_TYPE_EDGE_BOTH>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb11_fusb301a_pins>;
		vbus-supply = <&usb11_vbus>;

		connector {
			compatible = "usb-c-connector";
			label = "Gemini right USB-C";
			power-role = "source";
			data-role = "host";
			typec-power-opmode = "default";
			pd-disable;
		};
	};

	/*
	 * LK establishes the BQ25896 input and charge policy. Preserve those
	 * limits and service only the watchdog it handed to Linux.
	 */
	bq25896_charger: charger@6b {
		compatible = "ti,bq25896", "ti,bq25890";
		reg = <0x6b>;
		ti,adopt-firmware-settings;
		status = "okay";
	};

	/* FAN49101 is populated, but keep the regulator and consumer disabled. */
	fan49101: regulator@70 {
		compatible = "onsemi,fan49101";
		reg = <0x70>;
		status = "disabled";

		regulators {
			fan49101_vout: vout {
				regulator-name = "fan49101-vout";
				regulator-min-microvolt = <603000>;
				regulator-max-microvolt = <1413000>;
			};
		};
	};
};

&usb11_tphy {
	status = "okay";
};

&usb11_u2 {
	mediatek,force-a-session-valid;
	status = "okay";
};

&usb11 {
	status = "okay";
};

&mfgsys {
	status = "okay";
};

/*
 * Start Panfrost at the LK-proven 500.5 MHz clock and the conservative
 * voltage of the next higher vendor operating point.  Add DVFS only after
 * this fixed point has completed real rendering and suspend/resume tests.
 */
&gpu {
	mali-supply = <&rt5735_vgpu>;
	operating-points-v2 = <&gpu_fixed_opp_table>;
	status = "okay";
};

&{/} {
	gpu_fixed_opp_table: gpu-opp-table {
		compatible = "operating-points-v2";

		opp-500500000 {
			opp-hz = /bits/ 64 <500500000>;
			opp-microvolt = <975000>;
		};
	};

	hall_gpio_keys: gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&hall_pins>;
		status = "disabled";

		hall-switch {
			/* Vendor hall.c maps raw low to FCOVER_CLOSE/SW_LID=1. */
			label = "Hall lid";
			linux,input-type = <EV_SW>;
			linux,code = <SW_LID>;
			gpios = <&pio 66 GPIO_ACTIVE_LOW>;
			debounce-interval = <64>;
		};
	};
};
