				reg = <0>;
				remote-endpoint = <&gemini_rdma0_in>;
			};
		};
	};
};

&ufoe {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0>;

			gemini_ufoe_in: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&gemini_rdma0_out>;
			};
		};

		port@1 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <1>;

			gemini_ufoe_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&gemini_dsi0_in>;
			};
		};
	};
};

&dsi0 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	gemini_panel: panel@0 {
		compatible = "planet,gemini-pda-nt36672";
		reg = <0>;
		outp-supply = <&outp>;
		outn-supply = <&outn>;
		/* Vendor aeon6797_6m_n.dts identifies GPIO180 as LCM_RST. */
		reset-gpios = <&pio 180 GPIO_ACTIVE_HIGH>;
		rotation = <270>;
		backlight = <&backlight>;

		port {
			gemini_panel_in: endpoint {
				remote-endpoint = <&gemini_dsi0_out>;
			};
		};
	};
};

&dsi0_in {
	#address-cells = <1>;
	#size-cells = <0>;

	gemini_dsi0_in: endpoint@0 {
		reg = <0>;
		remote-endpoint = <&gemini_ufoe_out>;
	};
};

&dsi0_out {
	#address-cells = <1>;
	#size-cells = <0>;

	gemini_dsi0_out: endpoint@0 {
		reg = <0>;
		remote-endpoint = <&gemini_panel_in>;
	};
};

&afe {
	status = "okay";
};

/*
 * Cameras. Both slots take the vendor-named "SP5509" module,
 * whose vendor driver matches the SK Hynix Hi-556 (chip ID 0x0556 at
 * register 0x0f16, and the same register programme). Wiring from the
 * vendor DWS and kd_camera_hw.c:
 *   main: I2C2, CMMCLK0 (GPIO30), reset GPIO32, powerdown GPIO28
 *   sub:  I2C3, CMMCLK1 (GPIO31), reset GPIO33, powerdown GPIO29
 * Rails: DOVDD VCAMIO 1.8 V, AVDD VCAMA 2.8 V, DVDD VCAMD 1.21 V, 24 MHz
 * MCLK, two CSI-2 data lanes. The vendor drivers probe both 8-bit
 * addresses 0x40 and 0x50 (7-bit 0x20/0x28): the main driver tries 0x50
 * first and the sub driver 0x40 first; those are the addresses used.
 * Which physical slot is populated varies by unit. There is no CSI-2
 * receiver yet, so the endpoints have no remote.
 */
&camsys {
	power-domains = <&scpsys MT6797_POWER_DOMAIN_ISP>;
	status = "okay";
};

&i2c2 {
	#address-cells = <1>;
	#size-cells = <0>;
	/* The vendor DWS runs this bus at 300 kHz. */
	clock-frequency = <300000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_pins_a>;
	status = "okay";

	camera_main: camera@28 {
		compatible = "hynix,hi556";
		reg = <0x28>;
		pinctrl-names = "default";
		pinctrl-0 = <&camera_main_pins>;
		clocks = <&seninf_mclk 0>;
		assigned-clocks = <&seninf_mclk 0>;
		assigned-clock-rates = <24000000>;
		dovdd-supply = <&mt6351_vcamio_reg>;
		avdd-supply = <&mt6351_vcama_reg>;
		dvdd-supply = <&mt6351_vcamd_reg>;
		reset-gpios = <&pio 32 GPIO_ACTIVE_LOW>;
		powerdown-gpios = <&pio 28 GPIO_ACTIVE_LOW>;

		port {
			endpoint {
				data-lanes = <1 2>;
			};
		};
	};
};

&m4u {
	status = "okay";
};

/* VENC_CG is only accessible with the VENC power domain on. */
&vencsys {
	power-domains = <&scpsys MT6797_POWER_DOMAIN_VENC>;
};

&larb1 {
	status = "okay";
};

&vcodec_decoder {
	status = "okay";
};

&larb3 {
	status = "okay";
};

&jpeg_encoder {
	status = "okay";
};

&jpeg_decoder {
	status = "okay";
};

&auxadc {
	/* Thermal owns indirect AUXADC sampling and its clock. */
	status = "disabled";
};

&mt6351fg {
	status = "disabled";
};

&mt6351fgadc {
	status = "okay";
	power-supplies = <&battery_charger>;
	monitored-battery = <&gemini_battery>;
	mediatek,initialize-fgadc;
	/* VA18 feeds the FGADC analog front end. */
	vdda-supply = <&mt6351_va18_reg>;
	mediatek,fgadc-init-control = <0x28>;
	mediatek,fgadc-osr = <8>;
	mediatek,fg-resistance-milliohm = <10>;
	mediatek,fg-board-base = <1000>;
	mediatek,fg-board-slope = <1000>;
	/* Active vendor MT6351 header default; its generic DTS is not used. */
	mediatek,car-tune = <115>;
	mediatek,fg-trim-permille = <1000>;
};

&mmc1 {
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&microsd_mmc1_pins>;
	/* No electrical UHS transition is permitted; retain the 3.0 V state. */
	pinctrl-1 = <&microsd_mmc1_pins>;
	bus-width = <4>;
	/* Legacy SD default speed: below the unmodelled high-speed pad contract. */
	max-frequency = <25000000>;
	/* Stock board wiring asserts GPIO67 high when a card is inserted. */
	cd-gpios = <&pio 67 GPIO_ACTIVE_HIGH>;
	no-1-8-v;
	vmmc-supply = <&mt6351_vmch_reg>;
	vqmmc-supply = <&mt6351_vmc_reg>;
	status = "okay";
};

/*
 * Panfrost attaches the four MFG core domains before its OPP setup takes a
 * regulator vote.  Make the parent MFG transition own the VGPU prerequisite
 * so the rail is enabled before PWR_ON is asserted and remains ordered for
 * every later runtime transition.
 */
&scpsys {
	/delete-property/ mfg-supply;
	mfg_async-supply = <&rt5735_vgpu>;
	mediatek,gemini-gpuldo-owner;
};

&mfgsys {
	status = "okay";
};

&btif {
	status = "okay";
};

&{/t-phy@11290000} {
	status = "okay";
};

&cpu_sram {
	regulator-name = "vsram-a53-cci";
	regulator-min-microvolt = <1000000>;
	regulator-max-microvolt = <1200000>;
	regulator-coupled-with = <&da9214_bucka>;
	regulator-coupled-max-spread = <300000>;
	regulator-always-on;
	status = "okay";
};

&cpuclk {
	status = "okay";
};

&vsram_big {
	status = "okay";
};

&cci_dvfs {
	proc-supply = <&da9214_bucka>;
	operating-points-v2 = <&cci_opp>;
	status = "okay";
};
