		port@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0>;

			gemini_od0_in: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&gemini_gamma0_out>;
			};
		};

		port@1 {
			#address-cells = <1>;
