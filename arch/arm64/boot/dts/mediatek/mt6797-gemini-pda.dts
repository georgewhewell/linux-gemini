/dts-v1/;

#include "mt6797.dtsi"
#include "mt6797-gemini-battery.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/gpio-keys.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pinctrl/mt6797-pinfunc.h>
#include <dt-bindings/clock/mt6797-clk.h>
#include <dt-bindings/power/mt6797-power.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/reset/mt6797-resets.h>
#include <dt-bindings/thermal/thermal.h>

/ {
	model = "Planet Computers Gemini PDA";
	chassis-type = "handset";
	compatible = "planet,gemini-pda", "mediatek,mt6797";
	#address-cells = <2>;
	#size-cells = <2>;

	aliases {
		serial0 = &uart0;
		mmc0 = "/mmc@11230000";
		mmc1 = "/mmc@11240000";
	};

	chosen {
		stdout-path = "serial0:921600n8";
	};

	gpu_opp_table: opp-table-gpu {
		compatible = "operating-points-v2";

		/* Conservative points for non-type-12 and unclassified parts. */
		opp-204000000-safe {
			opp-hz = /bits/ 64 <204000000>;
			opp-microvolt = <859500 859500 862500>;
			opp-supported-hw = <0x80000840>;
		};

		opp-238000000-safe {
			opp-hz = /bits/ 64 <238000000>;
			opp-microvolt = <859500 859500 862500>;
			opp-supported-hw = <0x737>;
		};

		opp-238000000 {
			opp-hz = /bits/ 64 <238000000>;
			opp-microvolt = <846700 846700 850000>;
			opp-supported-hw = <0x1000>;
		};

		opp-365000000 {
			opp-hz = /bits/ 64 <365000000>;
			opp-microvolt = <910800 910800 912500>;
			opp-supported-hw = <0x1000>;
		};

		opp-442500000 {
			opp-hz = /bits/ 64 <442500000>;
			opp-microvolt = <936500 936500 937500>;
			opp-supported-hw = <0x1000>;
		};

		opp-520000000 {
			opp-hz = /bits/ 64 <520000000>;
			opp-microvolt = <975000 975000 975000>;
			opp-supported-hw = <0x1000>;
		};

		opp-610000000 {
			opp-hz = /bits/ 64 <610000000>;
			opp-microvolt = <1013400 1013400 1018750>;
			opp-supported-hw = <0x1000>;
		};

		opp-780000000 {
			opp-hz = /bits/ 64 <780000000>;
			opp-microvolt = <1103200 1103200 1106250>;
			opp-supported-hw = <0x1000>;
		};

		opp-900000000 {
			opp-hz = /bits/ 64 <900000000>;
			opp-microvolt = <1154500 1154500 1156250>;
			opp-supported-hw = <0x1000>;
		};
	};

	firmware {
		mt6797_atag_devinfo: atag-devinfo {
			compatible = "mediatek,mt6797-atag-devinfo";
			#address-cells = <1>;
			#size-cells = <1>;
			read-only;

			mt6797_thermal_calibration: calibration-data@0 {
				reg = <0 12>;
			};

			mt6797_ptp_calibration: ptp-calibration-data@c {
				reg = <12 76>;
			};

			mt6797_cpu_efuse_identity: cpu-efuse-identity@58 {
				reg = <88 12>;
			};

			mt6797_usb3_intr: usb3-intr@64 {
				reg = <100 4>;
			};

			mt6797_usb3_rx_imp: usb3-rx-imp@68 {
				reg = <104 4>;
			};

			mt6797_usb3_tx_imp: usb3-tx-imp@6c {
				reg = <108 4>;
			};
		};
	};

	cci_opp: opp-table-cci {
		compatible = "operating-points-v2";

		opp-169000000 {
			opp-hz = /bits/ 64 <169000000>;
			opp-microvolt = <770000 770000 1200000>;
		};

		opp-234000000 {
			opp-hz = /bits/ 64 <234000000>;
			opp-microvolt = <800000 800000 1200000>;
		};

		opp-325000000 {
			opp-hz = /bits/ 64 <325000000>;
			opp-microvolt = <850000 850000 1200000>;
		};

		opp-416000000 {
			opp-hz = /bits/ 64 <416000000>;
			opp-microvolt = <900000 900000 1200000>;
		};

		opp-481000000 {
			opp-hz = /bits/ 64 <481000000>;
			opp-microvolt = <940000 940000 1200000>;
		};

		opp-533000000 {
			opp-hz = /bits/ 64 <533000000>;
			opp-microvolt = <970000 970000 1200000>;
		};

		opp-611000000 {
			opp-hz = /bits/ 64 <611000000>;
			opp-microvolt = <1000000 1000000 1200000>;
		};

		opp-676000000 {
			opp-hz = /bits/ 64 <676000000>;
			opp-microvolt = <1040000 1040000 1200000>;
		};

		opp-754000000 {
			opp-hz = /bits/ 64 <754000000>;
			opp-microvolt = <1070000 1070000 1200000>;
		};

		opp-819000000 {
			opp-hz = /bits/ 64 <819000000>;
			opp-microvolt = <1100000 1100000 1200000>;
		};

		opp-845000000 {
			opp-hz = /bits/ 64 <845000000>;
			opp-microvolt = <1130000 1130000 1200000>;
		};

		opp-884000000 {
			opp-hz = /bits/ 64 <884000000>;
			opp-microvolt = <1140000 1140000 1200000>;
		};

		opp-910000000 {
			opp-hz = /bits/ 64 <910000000>;
			opp-microvolt = <1150000 1150000 1200000>;
		};

		opp-936000000 {
			opp-hz = /bits/ 64 <936000000>;
			opp-microvolt = <1170000 1170000 1200000>;
		};

		opp-975000000 {
			opp-hz = /bits/ 64 <975000000>;
			opp-microvolt = <1190000 1190000 1200000>;
		};

		opp-988000000 {
			opp-hz = /bits/ 64 <988000000>;
			opp-microvolt = <1200000 1200000 1200000>;
		};
	};

	/* MT6797 CPU_LEVEL_1, 0119 TT: nominal vendor voltages, no PTP offsets. */
	cluster2_opp: opp-table-cluster2 {
		compatible = "operating-points-v2";
		opp-shared;

		opp-338000000 {
			opp-hz = /bits/ 64 <338000000>;
			opp-microvolt = <800000>;
			clock-latency-ns = <5000000>;
		};

		opp-676000000 {
			opp-hz = /bits/ 64 <676000000>;
			opp-microvolt = <850000>;
			clock-latency-ns = <5000000>;
		};

		opp-845000000 {
			opp-hz = /bits/ 64 <845000000>;
			opp-microvolt = <880000>;
			clock-latency-ns = <5000000>;
		};

		opp-1001000000 {
			opp-hz = /bits/ 64 <1001000000>;
			opp-microvolt = <900000>;
			clock-latency-ns = <5000000>;
		};

		opp-1131000000 {
			opp-hz = /bits/ 64 <1131000000>;
			opp-microvolt = <930000>;
			clock-latency-ns = <5000000>;
		};

		opp-1378000000 {
			opp-hz = /bits/ 64 <1378000000>;
			opp-microvolt = <980000>;
			clock-latency-ns = <5000000>;
		};

		opp-1495000000 {
			opp-hz = /bits/ 64 <1495000000>;
			opp-microvolt = <1000000>;
			clock-latency-ns = <5000000>;
		};

		opp-1677000000 {
			opp-hz = /bits/ 64 <1677000000>;
			opp-microvolt = <1040000>;
			clock-latency-ns = <5000000>;
		};

		opp-1885000000 {
			opp-hz = /bits/ 64 <1885000000>;
			opp-microvolt = <1080000>;
			clock-latency-ns = <5000000>;
		};

		opp-2093000000 {
			opp-hz = /bits/ 64 <2093000000>;
			opp-microvolt = <1110000>;
			clock-latency-ns = <5000000>;
		};

		opp-2158000000 {
			opp-hz = /bits/ 64 <2158000000>;
			opp-microvolt = <1130000>;
			clock-latency-ns = <5000000>;
		};

		opp-2223000000 {
			opp-hz = /bits/ 64 <2223000000>;
			opp-microvolt = <1140000>;
			clock-latency-ns = <5000000>;
		};

		opp-2262000000 {
			opp-hz = /bits/ 64 <2262000000>;
			opp-microvolt = <1150000>;
			clock-latency-ns = <5000000>;
		};

		opp-2327000000 {
			opp-hz = /bits/ 64 <2327000000>;
			opp-microvolt = <1160000>;
			clock-latency-ns = <5000000>;
		};

		opp-2431000000 {
			opp-hz = /bits/ 64 <2431000000>;
			opp-microvolt = <1180000>;
			clock-latency-ns = <5000000>;
		};

		opp-2587000000 {
			opp-hz = /bits/ 64 <2587000000>;
			opp-microvolt = <1200000>;
			clock-latency-ns = <5000000>;
		};
	};

	/*
	 * Vendor CPU_LEVEL_1 (SB) tables: mt_cpufreq.c OPP_TBL(LL, SB) and
	 * OPP_TBL(L, SB), selected on Gemini by the function-code efuse.  Each
	 * voltage is the uncalibrated minimum for its rate on the shared
	 * vproc-little rail, which may run up to the vendor 1.2 V ceiling.
	 *
	 * vproc-little also supplies the CCI. Its voltage consumer now follows
	 * CPU activity. The coupler holds the inherited voltage until CCI owns
	 * its vote, then coordinates CPU/SRAM changes. The clock provider
	 * coordinates ARMPLL and CKDIV, using a divided MAINPLL fallback for
	 * PLL postdivider changes.
	 */
	cluster0_opp: opp-table-cluster0 {
		compatible = "operating-points-v2";
		opp-shared;
		status = "okay";

		opp-221000000 {
			opp-hz = /bits/ 64 <221000000>;
			opp-microvolt = <770000 770000 1200000>;
		};

		opp-338000000 {
			opp-hz = /bits/ 64 <338000000>;
			opp-microvolt = <800000 800000 1200000>;
		};

		opp-481000000 {
			opp-hz = /bits/ 64 <481000000>;
			opp-microvolt = <850000 850000 1200000>;
		};

		opp-624000000 {
			opp-hz = /bits/ 64 <624000000>;
			opp-microvolt = <900000 900000 1200000>;
		};

		opp-715000000 {
			opp-hz = /bits/ 64 <715000000>;
			opp-microvolt = <940000 940000 1200000>;
		};

		opp-806000000 {
			opp-hz = /bits/ 64 <806000000>;
			opp-microvolt = <970000 970000 1200000>;
		};

		opp-897000000 {
			opp-hz = /bits/ 64 <897000000>;
			opp-microvolt = <1000000 1000000 1200000>;
		};

		opp-1014000000 {
			opp-hz = /bits/ 64 <1014000000>;
			opp-microvolt = <1040000 1040000 1200000>;
		};

		opp-1118000000 {
			opp-hz = /bits/ 64 <1118000000>;
			opp-microvolt = <1070000 1070000 1200000>;
		};

		opp-1222000000 {
			opp-hz = /bits/ 64 <1222000000>;
			opp-microvolt = <1100000 1100000 1200000>;
		};

		opp-1274000000 {
			opp-hz = /bits/ 64 <1274000000>;
			opp-microvolt = <1130000 1130000 1200000>;
		};

		opp-1339000000 {
			opp-hz = /bits/ 64 <1339000000>;
			opp-microvolt = <1140000 1140000 1200000>;
		};

		opp-1391000000 {
			opp-hz = /bits/ 64 <1391000000>;
			opp-microvolt = <1150000 1150000 1200000>;
		};

		opp-1443000000 {
			opp-hz = /bits/ 64 <1443000000>;
			opp-microvolt = <1170000 1170000 1200000>;
		};

		opp-1495000000 {
			opp-hz = /bits/ 64 <1495000000>;
			opp-microvolt = <1190000 1190000 1200000>;
		};

		opp-1547000000 {
			opp-hz = /bits/ 64 <1547000000>;
			opp-microvolt = <1200000 1200000 1200000>;
		};
	};

	cluster1_opp: opp-table-cluster1 {
		compatible = "operating-points-v2";
		opp-shared;
		status = "okay";

		opp-325000000 {
			opp-hz = /bits/ 64 <325000000>;
			opp-microvolt = <770000 770000 1200000>;
		};

		opp-468000000 {
			opp-hz = /bits/ 64 <468000000>;
			opp-microvolt = <800000 800000 1200000>;
		};

		opp-650000000 {
			opp-hz = /bits/ 64 <650000000>;
			opp-microvolt = <850000 850000 1200000>;
		};

		opp-832000000 {
			opp-hz = /bits/ 64 <832000000>;
			opp-microvolt = <900000 900000 1200000>;
		};

		opp-962000000 {
			opp-hz = /bits/ 64 <962000000>;
			opp-microvolt = <940000 940000 1200000>;
		};

		opp-1092000000 {
			opp-hz = /bits/ 64 <1092000000>;
			opp-microvolt = <970000 970000 1200000>;
		};

		opp-1209000000 {
			opp-hz = /bits/ 64 <1209000000>;
			opp-microvolt = <1000000 1000000 1200000>;
		};

		opp-1352000000 {
			opp-hz = /bits/ 64 <1352000000>;
			opp-microvolt = <1040000 1040000 1200000>;
		};

		opp-1495000000 {
			opp-hz = /bits/ 64 <1495000000>;
			opp-microvolt = <1070000 1070000 1200000>;
		};

		opp-1625000000 {
			opp-hz = /bits/ 64 <1625000000>;
			opp-microvolt = <1100000 1100000 1200000>;
		};

		opp-1703000000 {
			opp-hz = /bits/ 64 <1703000000>;
			opp-microvolt = <1130000 1130000 1200000>;
		};

		opp-1755000000 {
			opp-hz = /bits/ 64 <1755000000>;
			opp-microvolt = <1140000 1140000 1200000>;
		};

		opp-1820000000 {
			opp-hz = /bits/ 64 <1820000000>;
			opp-microvolt = <1150000 1150000 1200000>;
		};

		opp-1885000000 {
			opp-hz = /bits/ 64 <1885000000>;
			opp-microvolt = <1170000 1170000 1200000>;
		};

		opp-1950000000 {
			opp-hz = /bits/ 64 <1950000000>;
			opp-microvolt = <1190000 1190000 1200000>;
		};

		opp-2002000000 {
			opp-hz = /bits/ 64 <2002000000>;
			opp-microvolt = <1200000 1200000 1200000>;
		};
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0 0x40000000 1 0>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		memory@40000000 {
			reg = <0 0x40000000 0 0x1000>;
			no-map;
		};

		memory@44400000 {
			reg = <0 0x44400000 0 0x10000>;
			no-map;
		};

		ramoops@44410000 {
			compatible = "ramoops";
			reg = <0 0x44410000 0 0xe0000>;
			record-size = <0x1000>;
			console-size = <0x10000>;
			ftrace-size = <0x1000>;
			pmsg-size = <0x20000>;
			mem-type = <0>;
			no-map;
		};

		memory@444f0000 {
			reg = <0 0x444f0000 0 0x10000>;
			no-map;
		};

		memory@44600000 {
			reg = <0 0x44600000 0 0x10000>;
			no-map;
		};

		memory@44610000 {
			reg = <0 0x44610000 0 0x30000>;
			no-map;
		};

		memory@44640000 {
			reg = <0 0x44640000 0 0x30000>;
			no-map;
		};

		memory@44800000 {
			reg = <0 0x44800000 0 0x100000>;
			no-map;
		};

		memory@46000000 {
			reg = <0 0x46000000 0 0x400000>;
			no-map;
		};

		md1_reserved_memory: reserve-memory-ccci_md1 {
			compatible = "mediatek,reserve-memory-ccci_md1";
			no-map;
			size = <0 0xa100000>;
			alignment = <0 0x2000000>;
			alloc-ranges = <0 0x40000000 0 0x80000000>;
		};

		md1_shared_memory: reserve-memory-ccci_share {
			compatible = "mediatek,reserve-memory-ccci_share";
			no-map;
			size = <0 0x600000>;
			alignment = <0 0x4000000>;
			alloc-ranges = <0 0x40000000 0 0x50000000>;
		};

		consys_reserved_memory: consys-reserve-memory {
			compatible = "mediatek,consys-reserve-memory";
			no-map;
			size = <0 0x200000>;
			alignment = <0 0x200000>;
			alloc-ranges = <0 0x40000000 0 0x80000000>;
		};

		spm-reserve-memory {
			compatible = "mediatek,spm-reserve-memory";
			no-map;
			size = <0 0x16000>;
			alignment = <0 0x10000>;
			alloc-ranges = <0 0x40000000 0 0x80000000>;
		};

		reserve-memory-scp_share {
			compatible = "mediatek,reserve-memory-scp_share";
			no-map;
			size = <0 0x1000000>;
			alignment = <0 0x1000000>;
			alloc-ranges = <0 0x40000000 0 0x50000000>;
		};
	};

	gnss_lna: regulator-gnss-lna {
		compatible = "regulator-fixed";
		regulator-name = "gnss-lna";
		gpios = <&pio 69 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		pinctrl-names = "default";
		pinctrl-0 = <&gnss_lna_pins>;
	};

	consys: consys@18070000 {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		compatible = "mediatek,mt6797-consys";
		reg = <0 0x18070000 0 0x200>,
		      <0 0x10007000 0 0x100>,
		      <0 0x10000000 0 0x2000>,
		      <0 0x10006000 0 0x1000>,
		      <0 0x180b6000 0 0x100>;
		reg-names = "mcu", "ap-rgu", "topckgen", "spm", "afe";
		interrupts = <GIC_SPI 284 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_SPI 285 IRQ_TYPE_LEVEL_LOW>;
		interrupt-names = "bgf", "wdt";
		resets = <&watchdog MT6797_TOPRGU_CONMCU_SW_RST>;
		reset-names = "conn-mcu";
		power-domains = <&scpsys MT6797_POWER_DOMAIN_CONN>;
		power-domain-names = "conn";
		vcn18-supply = <&mt6351_vcn18_reg>;
		vcn28-supply = <&mt6351_vcn28_reg>;
		vcn33-bt-supply = <&mt6351_vcn33_bt_reg>;
		vcn33-wifi-supply = <&mt6351_vcn33_wifi_reg>;
		memory-region = <&consys_reserved_memory>;
		memory-region-names = "shared";
		mediatek,emi-mpu = <&consys_emi_mpu>;
		mediatek,infracfg = <&infrasys>;
		mediatek,spm = <&scpsys>;
		mediatek,btif = <&btif>;
		status = "okay";

		gnss {
			compatible = "mediatek,mt6797-gnss";
			lna-supply = <&gnss_lna>;
			status = "okay";
		};

		bluetooth: bluetooth {
			compatible = "mediatek,mt6797-bluetooth";
			status = "okay";
		};

		wifi: wifi@180f0000 {
			compatible = "mediatek,mt6797-wifi";
			reg = <0 0x180f0000 0 0x1100>;
			interrupts = <GIC_SPI 283 IRQ_TYPE_LEVEL_LOW>;
			interrupt-names = "hif";
			status = "okay";
		};
	};

	consys_emi_mpu: emi-mpu@10203000 {
		compatible = "mediatek,mt6797-consys-emi-mpu";
		reg = <0 0x10203000 0 0x1000>,
		      <0 0x10000000 0 0x2000>;
		reg-names = "emi", "topckgen";
		memory-region = <&consys_reserved_memory>;
		memory-region-names = "shared";
		status = "okay";
		mediatek,experimental-shared-emi-ownership;
	};

	keyboard_matrix: keyboard-matrix {
		compatible = "gpio-matrix-keypad";
		pinctrl-names = "default";
		gpio-activelow;
		drive-inactive-cols;
		pinctrl-0 = <&keyboard_matrix_row_pins
				     &keyboard_matrix_col_pins>;
		row-gpios = <&aw9523 0 GPIO_ACTIVE_HIGH>,
			    <&aw9523 1 GPIO_ACTIVE_HIGH>,
			    <&aw9523 2 GPIO_ACTIVE_HIGH>,
			    <&aw9523 3 GPIO_ACTIVE_HIGH>,
			    <&aw9523 4 GPIO_ACTIVE_HIGH>,
			    <&aw9523 5 GPIO_ACTIVE_HIGH>,
			    <&aw9523 6 GPIO_ACTIVE_HIGH>,
			    <&aw9523 7 GPIO_ACTIVE_HIGH>;
		col-gpios = <&aw9523 8 GPIO_ACTIVE_HIGH>,
			    <&aw9523 9 GPIO_ACTIVE_HIGH>,
			    <&aw9523 10 GPIO_ACTIVE_HIGH>,
			    <&aw9523 11 GPIO_ACTIVE_HIGH>,
			    <&aw9523 12 GPIO_ACTIVE_HIGH>,
			    <&aw9523 13 GPIO_ACTIVE_HIGH>,
			    <&aw9523 14 GPIO_ACTIVE_HIGH>;
		linux,keymap = <
			MATRIX_KEY(0, 0, KEY_1)
			MATRIX_KEY(1, 0, KEY_U)
			MATRIX_KEY(2, 0, KEY_S)
			MATRIX_KEY(3, 0, KEY_Z)
			MATRIX_KEY(4, 0, KEY_COMMA)
			MATRIX_KEY(5, 0, KEY_APOSTROPHE)
			MATRIX_KEY(6, 0, KEY_8)
			MATRIX_KEY(7, 0, KEY_J)
			MATRIX_KEY(0, 1, KEY_2)
			MATRIX_KEY(1, 1, KEY_W)
			MATRIX_KEY(2, 1, KEY_D)
			MATRIX_KEY(3, 1, KEY_C)
			MATRIX_KEY(4, 1, KEY_LEFTALT)
			MATRIX_KEY(5, 1, KEY_LEFT)
			MATRIX_KEY(6, 1, KEY_9)
			MATRIX_KEY(7, 1, KEY_K)
			MATRIX_KEY(0, 2, KEY_3)
			MATRIX_KEY(1, 2, KEY_Y)
			MATRIX_KEY(2, 2, KEY_TAB)
			MATRIX_KEY(3, 2, KEY_N)
			MATRIX_KEY(4, 2, KEY_M)
			MATRIX_KEY(5, 2, KEY_DOWN)
			MATRIX_KEY(6, 2, KEY_BACKSPACE)
			MATRIX_KEY(7, 2, KEY_I)
			MATRIX_KEY(0, 3, KEY_4)
			MATRIX_KEY(1, 3, KEY_T)
			MATRIX_KEY(2, 3, KEY_F)
			MATRIX_KEY(3, 3, KEY_X)
			MATRIX_KEY(4, 3, KEY_LEFTMETA)
			MATRIX_KEY(5, 3, KEY_RIGHTSHIFT)
			MATRIX_KEY(6, 3, KEY_P)
			MATRIX_KEY(0, 4, KEY_5)
			MATRIX_KEY(1, 4, KEY_E)
			MATRIX_KEY(2, 4, KEY_G)
			MATRIX_KEY(3, 4, KEY_V)
			MATRIX_KEY(4, 4, KEY_SPACE)
			MATRIX_KEY(5, 4, KEY_UP)
			MATRIX_KEY(6, 4, KEY_O)
			MATRIX_KEY(0, 5, KEY_6)
			MATRIX_KEY(1, 5, KEY_Q)
			MATRIX_KEY(2, 5, KEY_A)
			MATRIX_KEY(3, 5, KEY_B)
			MATRIX_KEY(4, 5, KEY_DOT)
			MATRIX_KEY(5, 5, KEY_RIGHT)
			MATRIX_KEY(6, 5, KEY_ENTER)
			MATRIX_KEY(0, 6, KEY_7)
			MATRIX_KEY(1, 6, KEY_R)
			MATRIX_KEY(2, 6, KEY_H)
			MATRIX_KEY(3, 6, KEY_LEFTSHIFT)
			MATRIX_KEY(4, 6, KEY_LEFTCTRL)
			MATRIX_KEY(5, 6, KEY_L)
			MATRIX_KEY(6, 6, KEY_0)>;
		status = "okay";
		/*
		 * Keep the successful generic polling contract exact. There is no measured
		 * bounce interval, so do not invent debounce-delay-ms.
		 */
		poll-interval = <20>;
		col-scan-delay-us = <2>;
	};

	hall_gpio_keys: gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&hall_pins>;
		status = "okay";

		hall-switch {
			/* Vendor hall.c maps raw low to FCOVER_CLOSE/SW_LID=1. */
			label = "Hall lid";
			linux,input-type = <EV_SW>;
			linux,code = <SW_LID>;
			gpios = <&pio 66 GPIO_ACTIVE_LOW>;
			debounce-interval = <64>;
			/*
			 * Opening the lid wakes the system (vendor hall.c keeps
			 * EINT5 armed as a wake source); closing it does not.
			 */
			wakeup-source;
			wakeup-event-action = <EV_ACT_DEASSERTED>;
		};
	};

	/* Vendor usb1_drvvbus: GPIO94 high supplies the USB1 VBUS switch. */
	usb11_drvvbus: regulator-usb11-drvvbus {
		compatible = "regulator-fixed";
		regulator-name = "usb11-drvvbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&pio 94 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/* Vendor sw7226_en: GPIO72 is downstream of usb1_drvvbus. */
	usb11_vbus: regulator-usb11-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb11-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&pio 72 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		vin-supply = <&usb11_drvvbus>;
	};

	/*
	 * The vendor lcd-backlight LED node (aeon6797_6m_n.dts led@6) uses
	 * led_mode 5, MT65XX_LED_MODE_CUST_BLS_PWM: brightness is set only by
	 * the SoC display PWM, with 1024 duty steps and 0 turning the PWM off.
	 * The panel init table writes DCS brightness 0xff once and never
	 * changes it.  The MT6797 LK boots the backlight at LED_FULL, which it
	 * maps to the full 1023/1023 duty, so start at the top level too.
	 */
	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&disp_pwm 0 39385>;
		brightness-levels = <0 1023>;
		num-interpolated-steps = <1023>;
		default-brightness-level = <1023>;
	};

	gemini_audio: sound {
		compatible = "planet,gemini-mt6797-mt6351";
		pinctrl-names = "default";
		pinctrl-0 = <&gemini_microphone_pins &gemini_speaker_pins>;
		speaker-enable-gpios = <&pio 243 GPIO_ACTIVE_HIGH>,
				       <&pio 244 GPIO_ACTIVE_HIGH>;
		microphone-enable-gpios = <&pio 234 GPIO_ACTIVE_HIGH>;
		mediatek,platform = <&afe>;
		mediatek,audio-codec = <&mt6351_sound>;
		mediatek,headset-jack;
		status = "okay";
	};

	vibrator {
		compatible = "regulator-haptic";
		haptic-supply = <&mt6351_vibr_reg>;
		min-microvolt = <2800000>;
		max-microvolt = <2800000>;
	};

	/* SENINF timing generators 0/1 provide CMMCLK0/1. */
	seninf_mclk: clock-controller@1a040000 {
		compatible = "mediatek,mt6797-seninf-mclk";
		reg = <0 0x1a040000 0 0x2000>;
		clocks = <&camsys CLK_CAM_CAMTG>,
			 <&camsys CLK_CAM_SENINF>,
			 <&camsys CLK_CAM_CAMSYS>;
		clock-names = "camtg", "seninf", "camsys";
		power-domains = <&scpsys MT6797_POWER_DOMAIN_ISP>;
		#clock-cells = <1>;
		assigned-clocks = <&topckgen CLK_TOP_MUX_CAMTG>;
		assigned-clock-parents = <&topckgen CLK_TOP_UNIVPLL_D26>;
	};

	thermal-zones {
		soc-thermal {
			/* Full-rate load can reheat faster than a one-second poll. */
			polling-delay = <100>;
			polling-delay-passive = <40>;
			thermal-sensors = <&thermal>;

			trips {
				/*
				 * step_wise releases a trip completely once the
				 * temperature falls below trip - hysteresis while
				 * the state sits at the map's lower bound. With a
				 * narrow band, sensor noise under ten-core load
				 * toggles between full rate and the floor. Hold
				 * the cooling until the SoC is actually cool.
				 */
				cpu_throttle: cpu-throttle {
					/* Vendor CPU thermal policy starts cooling at 85 C. */
					temperature = <85000>;
					/* Keep the qualified 65 C release point. */
					hysteresis = <20000>;
					type = "passive";
				};

				cpu_limit: cpu-limit {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_crit: cpu-critical {
					temperature = <117000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map-gpu-throttle {
					trip = <&cpu_throttle>;
					cooling-device =
						<&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};

				map-cpu-throttle {
					trip = <&cpu_throttle>;
					/*
					 * State 8 caps LL/L/A72 at 1.014/1.352/1.677 GHz,
					 * allowing CCI to fall to 845 MHz and its shared
					 * CPU rail vote to 1.13 V.
					 */
					cooling-device =
						<&cpu0 8 THERMAL_NO_LIMIT>,
						<&cpu4 8 THERMAL_NO_LIMIT>,
						<&cpu8 8 THERMAL_NO_LIMIT>;
				};

				map-cpu-limit {
					trip = <&cpu_limit>;
					cooling-device =
						<&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu8 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};
	};

	md1_lk_handoff_probe: modem-lk-handoff-probe {
		compatible = "mediatek,mt6797-md1-lk-handoff-probe";
		mediatek,experimental-md1-lk-handoff-probe;
		mediatek,stage-lk-handoff-read-only;
		status = "okay";
	};

	md1_boot_status_observe: modem-boot-status@10201300 {
		compatible = "mediatek,mt6797-md1-boot-status-observe";
		reg = <0 0x10201300 0 0x8>,
		      <0 0x10209000 0 0x1000>,
		      <0 0x1020a000 0 0x1000>;
		reg-names = "md1-boot-status", "ap-ccif", "md-ccif";
		mediatek,spm = <&scpsys>;
		mediatek,infracfg = <&infrasys>;
		mediatek,experimental-md1-boot-status;
		status = "okay";
	};

	md1_remap_observe: modem-remap-observe@10001000 {
		compatible = "mediatek,mt6797-md1-remap-observe";
		reg = <0 0x10001000 0 0x1000>;
		reg-names = "infracfg-ao";
		mediatek,experimental-md1-remap-observe;
		mediatek,stage-lk-remap-observe-read-only;
		status = "okay";
	};

	md1_emi_mpu: modem-emi-mpu {
		compatible = "mediatek,mt6797-md1-emi-mpu";
		mediatek,experimental-md1-emi-mpu;
		status = "okay";
	};

	md1_cold_owner: modem-cold-owner@10001000 {
		compatible = "mediatek,mt6797-md1-cold-owner";
		/* Only the cold owner selects this state after recovery preflight. */
		pinctrl-names = "sim";
		pinctrl-0 = <&md1_sim_pins>;
		reg = <0 0x10001000 0 0x1000>,
		      <0 0x10209000 0 0x1000>,
		      <0 0x1020a000 0 0x1000>,
		      <0 0x10014000 0 0x1e00>,
		      <0 0x10219000 0 0x1e00>,
		      <0 0x1000c000 0 0x1000>,
		      <0 0x20150000 0 0x118>,
		      <0 0x20130000 0 0x1004>,
		      <0 0x20060000 0 0xd0>,
		      <0 0x260f0000 0 0x200>,
		      <0 0x20140000 0 0xa0>,
		      <0 0x20120000 0 0xd0>,
		      <0 0x200f0100 0 0x300>,
		      <0 0x26010000 0 0x40>,
		      <0 0x20000024 0 0x4>,
		      <0 0x10201300 0 0x8>;
		reg-names = "infracfg", "ap-ccif", "md-ccif", "ap-cldma-ao",
			    "ap-cldma-pdn", "apmixed",
			    "md-clksw", "md-dcm", "md-peri-misc", "md-l1-a0",
			    "md-top-pll", "md-sys-clk", "md-rgu", "l1-rgu",
			    "boot-vector", "boot-status";
		mediatek,experimental-md1-cold-owner;
		mediatek,stage-cold-reset-held;
		mediatek,pmic = <&pmic>;
		mediatek,boot-watchdog = <&watchdog>;
		resets = <&infrasys MT6797_INFRA_CLDMA_AO_RST>,
			 <&infrasys MT6797_INFRA_CLDMA_RST>;
		reset-names = "cldma-ao", "cldma-pdn";
		mediatek,spm = <&scpsys>;
		mediatek,emi-mpu = <&md1_emi_mpu>;
		mediatek,stage-md1-boot-vector-release;
		status = "okay";
	};

	md1_ccci: modem@10014000 {
		compatible = "mediatek,mt6797-ccci";
		interrupt-parent = <&sysirq>;
		reg = <0 0x10014000 0 0x1e00>,
		      <0 0x10015000 0 0x1e00>,
		      <0 0x10219000 0 0x1e00>,
		      <0 0x1021a000 0 0x1e00>,
		      <0 0x10209000 0 0x1000>,
		      <0 0x1020a000 0 0x1000>;
		reg-names = "ap-cldma-ao", "md-cldma-ao",
			    "ap-cldma-pdn", "md-cldma-pdn",
			    "ap-ccif", "md-ccif";
		interrupts = <GIC_SPI 265 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 147 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_SPI 266 IRQ_TYPE_EDGE_FALLING>;
		interrupt-names = "cldma", "ap-ccif", "md-wdt";
		memory-region = <&md1_shared_memory>;
		memory-region-names = "md-shared";
		status = "okay";

		rf-clock {
			/* Compiled Gemian board config; vendor 0.9mA override. */
			mediatek,configuration = <2 0 1 1>;
			mediatek,driving = <1 1 1 1>;
		};

		/* Known-good Gemian DT metadata, not AP IRQ/pin ownership. */
		sim-eint-1 {
			mediatek,eint-number = <0>;
			mediatek,debounce-us = <100000>;
			mediatek,active-high = <1>;
			mediatek,edge-triggered = <0>;
			mediatek,socket-type = <0>;
			mediatek,dedicated-enable = <0>;
			mediatek,source-selector = <1>;
		};

		sim-eint-2 {
			mediatek,eint-number = <1>;
			mediatek,debounce-us = <100000>;
			mediatek,active-high = <1>;
			mediatek,edge-triggered = <0>;
			mediatek,socket-type = <0>;
			mediatek,dedicated-enable = <0>;
			mediatek,source-selector = <0>;
		};
	};

	spm {
		compatible = "mediatek,mt6797-spm";
		mediatek,spm = <&scpsys>;
	};

	scp@10020000 {
		compatible = "mediatek,scp";
		reg = <0 0x10020000 0 0x80000>,
		      <0 0x100a0000 0 0x1000>,
		      <0 0x100a4000 0 0x1000>;
		interrupts = <GIC_SPI 199 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};
};

&md1 {
	memory-region = <&md1_reserved_memory>, <&md1_shared_memory>;
	memory-region-names = "md1", "shared";
	status = "disabled";
};

&gce {
	status = "disabled";
};

&cpu0 {
	clock-frequency = <1391000000>;
	clocks = <&cpuclk CLK_MCU_MP0>,
		 <&apmixedsys CLK_APMIXED_MAINPLL>;
	clock-names = "cpu", "intermediate";
	cpu-supply = <&da9214_bucka>;
	operating-points-v2 = <&cluster0_opp>;
	#cooling-cells = <2>;
};

&cpu1 {
	clock-frequency = <1391000000>;
	clocks = <&cpuclk CLK_MCU_MP0>,
		 <&apmixedsys CLK_APMIXED_MAINPLL>;
	clock-names = "cpu", "intermediate";
	cpu-supply = <&da9214_bucka>;
	operating-points-v2 = <&cluster0_opp>;
	#cooling-cells = <2>;
};

&cpu2 {
	clock-frequency = <1391000000>;
	clocks = <&cpuclk CLK_MCU_MP0>,
		 <&apmixedsys CLK_APMIXED_MAINPLL>;
	clock-names = "cpu", "intermediate";
	cpu-supply = <&da9214_bucka>;
	operating-points-v2 = <&cluster0_opp>;
	#cooling-cells = <2>;
};

/*
 * Keep all native-display consumers behind a userspace boundary. MMSYS still
 * publishes its clock provider at probe time; guarded power-domain, SMI, DSI
 * and panel consumers defer against the same MMSYS opt-in. Stage1 releases
 * that one-way boundary by writing 1 to activate_drm after watchdog service
 * is known good.
 */
&mmsys {
	mediatek,drm-on-demand;

	port {
		#address-cells = <1>;
		#size-cells = <0>;

		gemini_mmsys_out: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&gemini_ovl0_in>;
		};
	};
};

&cpu3 {
	clock-frequency = <1391000000>;
	clocks = <&cpuclk CLK_MCU_MP0>,
		 <&apmixedsys CLK_APMIXED_MAINPLL>;
	clock-names = "cpu", "intermediate";
	cpu-supply = <&da9214_bucka>;
	operating-points-v2 = <&cluster0_opp>;
	#cooling-cells = <2>;
};

&cpu4 {
	clock-frequency = <1950000000>;
	clocks = <&cpuclk CLK_MCU_MP1>,
		 <&apmixedsys CLK_APMIXED_MAINPLL>;
	clock-names = "cpu", "intermediate";
	cpu-supply = <&da9214_bucka>;
	operating-points-v2 = <&cluster1_opp>;
	#cooling-cells = <2>;
};

&cpu5 {
	clock-frequency = <1950000000>;
	clocks = <&cpuclk CLK_MCU_MP1>,
		 <&apmixedsys CLK_APMIXED_MAINPLL>;
	clock-names = "cpu", "intermediate";
	cpu-supply = <&da9214_bucka>;
	operating-points-v2 = <&cluster1_opp>;
	#cooling-cells = <2>;
};

&cpu6 {
	clock-frequency = <1950000000>;
	clocks = <&cpuclk CLK_MCU_MP1>,
		 <&apmixedsys CLK_APMIXED_MAINPLL>;
	clock-names = "cpu", "intermediate";
	cpu-supply = <&da9214_bucka>;
	operating-points-v2 = <&cluster1_opp>;
	#cooling-cells = <2>;
};

&cpu7 {
	clock-frequency = <1950000000>;
	clocks = <&cpuclk CLK_MCU_MP1>,
		 <&apmixedsys CLK_APMIXED_MAINPLL>;
	clock-names = "cpu", "intermediate";
	cpu-supply = <&da9214_bucka>;
	operating-points-v2 = <&cluster1_opp>;
	#cooling-cells = <2>;
};

&cpu8 {
	clock-frequency = <2288000000>;
	/* Both rails remain exclusively owned by a72-power. */
	operating-points-v2 = <&cluster2_opp>;
	#cooling-cells = <2>;
	status = "okay";
};

&cpu9 {
	clock-frequency = <2288000000>;
	/* Both rails remain exclusively owned by a72-power. */
	operating-points-v2 = <&cluster2_opp>;
	#cooling-cells = <2>;
	status = "okay";
};

&mt6351regulator {
	/* Shared analog supply of the left USB2 and SuperSpeed PHYs. */
	mt6351_va10_reg: ldo-va10 {
		regulator-name = "va10";
		regulator-min-microvolt = <950000>;
		regulator-max-microvolt = <950000>;
	};

	/*
	 * Despite its PMIC name this buck is the SoC core SRAM rail, which the
	 * vendor SPM switches with Vcore.  The Cortex-A53 SRAM is fed by on-die
	 * CPULDOs in INFRACFG_AO instead.
	 */
	mt6351_vsram_proc_reg: buck-vsram-proc {
		regulator-name = "vsram-proc";
		regulator-min-microvolt = <1000000>;
		regulator-max-microvolt = <1200000>;
		regulator-always-on;
	};

	/* Analog 1.8 V: audio codec, USB PHYs and the FGADC front end. */
	mt6351_va18_reg: ldo-va18 {
		regulator-name = "va18";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};

	mt6351_vcn18_reg: ldo-vcn18 {
		regulator-name = "vcn18";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};

	mt6351_vcn28_reg: ldo-vcn28 {
		regulator-name = "vcn28";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
	};

	mt6351_vcn33_bt_reg: ldo-vcn33-bt {
		regulator-name = "vcn33-bt";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	mt6351_vcn33_wifi_reg: ldo-vcn33-wifi {
		regulator-name = "vcn33-wifi";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	mt6351_vemc_reg: ldo-vemc {
		regulator-name = "vemc_3v3";
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
	};

	mt6351_vio18_reg: ldo-vio18 {
		regulator-name = "vio18";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	mt6351_vusb33_reg: ldo-vusb33 {
		regulator-name = "vusb33";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	mt6351_vibr_reg: ldo-vibr {
		regulator-name = "vibr";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		regulator-enable-ramp-delay = <44>;
	};

	mt6351_vcama_reg: ldo-vcama {
		regulator-name = "vcama";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
	};

	mt6351_vcamd_reg: ldo-vcamd {
		/* The vendor kernel raises the sensors' 1.2 V request to 1.21 V. */
		regulator-name = "vcamd";
		regulator-min-microvolt = <1210000>;
		regulator-max-microvolt = <1210000>;
	};

	mt6351_vcamio_reg: ldo-vcamio {
		regulator-name = "vcamio";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};

	/* Vendor MMC1 card rail: VMCH, constrained to its 3.0 V mode. */
	mt6351_vmch_reg: ldo-vmch {
		regulator-name = "vmch";
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3000000>;
	};

	/* Vendor MMC1 signalling rail: VMC, kept out of the 1.8 V UHS mode. */
	mt6351_vmc_reg: ldo-vmc {
		regulator-name = "vmc";
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3000000>;
	};
};

&pmic {
	power-controller {
		compatible = "mediatek,mt6351-pwrc";
	};

	pmic_keys: keys {
		compatible = "mediatek,mt6351-keys";
		/*
		 * Keep the vendor long-press policy: power key alone resets
		 * the PMIC after 11 s. This is the only way to recover a hung
		 * Gemini, which has no removable battery.
		 */
		mediatek,long-press-mode = <1>;
		power-off-time-sec = <11>;

		power {
			linux,keycodes = <KEY_POWER>;
			wakeup-source;
		};
	};

	mt6351_sound: mt6351-sound {
		compatible = "mediatek,mt6351-sound";
		#sound-dai-cells = <0>;
		vusb33-supply = <&mt6351_vusb33_reg>;
		va18-supply = <&mt6351_va18_reg>;
		mediatek,jack-detection;
		mediatek,accdet-pwm-settings = <0x500 0x500 1 0x1f0 0x800 0x800 0x20>;
		status = "okay";
	};
};

&pio {
	md1_sim_pins: md1-sim-pins {
		pins-hot-plug {
			pinmux = <MT6797_GPIO112__FUNC_MD_INT1_C2K_UIM1_HOT_PLUG_IN>,
				 <MT6797_GPIO113__FUNC_MD_INT0_C2K_UIM0_HOT_PLUG_IN>;
			bias-pull-up;
			input-enable;
			input-schmitt-enable;
		};

		pins-clk-rst {
			pinmux = <MT6797_GPIO126__FUNC_MD1_SIM1_SCLK>,
				 <MT6797_GPIO127__FUNC_MD1_SIM1_SRST>,
				 <MT6797_GPIO155__FUNC_MD1_SIM2_SCLK>,
				 <MT6797_GPIO156__FUNC_MD1_SIM2_SRST>;
			bias-disable;
			input-enable;
			input-schmitt-enable;
			output-enable;
		};

		pins-data {
			pinmux = <MT6797_GPIO128__FUNC_MD1_SIM1_SIO>,
				 <MT6797_GPIO157__FUNC_MD1_SIM2_SIO>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_10>;
			input-enable;
			input-schmitt-enable;
		};
	};

	gnss_lna_pins: gnss-lna-pins {
		pins {
			pinmux = <MT6797_GPIO69__FUNC_GPIO69>;
		};
	};

	/*
	 * MT6797 pinctrl currently supports pinmux only for these pads:
	 * its descriptor has no pull, IES, or drive-strength register maps.
	 * Keep boot-firmware pad configuration until those maps are recovered.
	 */
	uart0_gemini_pins: uart0-gemini-pins {
		pins-rx-tx {
			pinmux = <MT6797_GPIO97__FUNC_URXD0>,
				 <MT6797_GPIO98__FUNC_UTXD0>;
		};
	};

	mmc0_pins_default: mmc0-default-pins {
		pins-cmd-dat {
			pinmux = <MT6797_GPIO114__FUNC_MSDC0_DAT0>,
				 <MT6797_GPIO115__FUNC_MSDC0_DAT1>,
				 <MT6797_GPIO116__FUNC_MSDC0_DAT2>,
				 <MT6797_GPIO117__FUNC_MSDC0_DAT3>,
				 <MT6797_GPIO118__FUNC_MSDC0_DAT4>,
				 <MT6797_GPIO119__FUNC_MSDC0_DAT5>,
				 <MT6797_GPIO120__FUNC_MSDC0_DAT6>,
				 <MT6797_GPIO121__FUNC_MSDC0_DAT7>,
				 <MT6797_GPIO122__FUNC_MSDC0_CMD>;
			drive-strength = <4>;
			mediatek,tdsel = <12>;
			mediatek,rdsel = <0>;
			input-enable;
			input-schmitt-enable;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};

		pins-clk {
			pinmux = <MT6797_GPIO123__FUNC_MSDC0_CLK>;
			drive-strength = <4>;
			mediatek,tdsel = <12>;
			mediatek,rdsel = <0>;
			input-enable;
			input-schmitt-enable;
			bias-pull-down = <MTK_PUPD_SET_R1R0_01>;
		};

		pins-ds {
			pinmux = <MT6797_GPIO124__FUNC_MSDC0_DSL>;
			drive-strength = <4>;
			mediatek,tdsel = <12>;
			mediatek,rdsel = <0>;
			input-enable;
			input-schmitt-enable;
			bias-pull-down = <MTK_PUPD_SET_R1R0_01>;
		};

		pins-rst {
			pinmux = <MT6797_GPIO125__FUNC_MSDC0_RSTB>;
			drive-strength = <4>;
			mediatek,tdsel = <12>;
			mediatek,rdsel = <0>;
			input-enable;
			input-schmitt-enable;
			bias-pull-up = <MTK_PUPD_SET_R1R0_10>;
		};
	};

	hall_pins: hall-pins {
		pins-hall {
			pinmux = <MT6797_GPIO66__FUNC_EINT5>;
		};
	};

	light_sensor_pins: light-sensor-pins {
		pins-irq {
			pinmux = <MT6797_GPIO88__FUNC_EINT11>;
		};
	};

	/*
	 * GPIO85 is EINT8 in the upstream MT6797 pin-function table.  Do not
	 * request a bias setting here: the upstream MT6797 pinctrl driver has no
	 * bias register map, so pinctrl would reject bias-disable with -ENOTSUPP
	 * when a future, separately enabled touchscreen client selects this state.
	 */
	touchscreen_irq_pins: touchscreen-irq-pins {
		pins-irq {
			pinmux = <MT6797_GPIO85__FUNC_EINT8>;
		};
	};

	aw9120_pins: aw9120-pins {
		pins-pdn {
			pinmux = <MT6797_GPIO245__FUNC_GPIO245>;
		};
	};

	keyboard_soc_pins: keyboard-soc-pins {
		pins-reset {
			pinmux = <MT6797_GPIO58__FUNC_GPIO58>;
			output-high;
		};

		pins-irq {
			pinmux = <MT6797_GPIO87__FUNC_EINT10>;
		};
	};

	usb11_fusb301a_pins: usb11-fusb301a-pins {
		/*
		 * GPIO64 is EINT3 on mainline MT6797, not EINT64.  Do not add a
		 * bias setting: the current MT6797 pinctrl descriptor has no pull
		 * register map and would reject it while selecting this state.
		 */
		pins-attach {
			pinmux = <MT6797_GPIO64__FUNC_EINT3>;
		};

		/* Vendor initial FUSB301A switch selection: GPIO70=1, GPIO71=0. */
		pins-data-mux-enable {
			pinmux = <MT6797_GPIO70__FUNC_GPIO70>;
			output-high;
		};

		pins-data-mux-select {
			pinmux = <MT6797_GPIO71__FUNC_GPIO71>;
			output-low;
		};
	};

	disp_pwm_pins: disp-pwm-pins {
		pins-pwm {
			pinmux = <MT6797_GPIO178__FUNC_DISP_PWM>;
		};
	};

	gemini_speaker_pins: speaker-pins {
		pins-enables {
			pinmux = <MT6797_GPIO243__FUNC_GPIO243>,
				 <MT6797_GPIO244__FUNC_GPIO244>;
			output-low;
		};
	};

	gemini_microphone_pins: microphone-pins {
		pins-enable {
			pinmux = <MT6797_GPIO234__FUNC_GPIO234>;
			output-low;
		};
	};

	camera_main_pins: camera-main-pins {
		pins-mclk {
			pinmux = <MT6797_GPIO30__FUNC_CMMCLK0>;
		};

		pins-ctrl {
			pinmux = <MT6797_GPIO32__FUNC_GPIO32>,
				 <MT6797_GPIO28__FUNC_GPIO28>;
		};
	};

	camera_sub_pins: camera-sub-pins {
		pins-mclk {
			pinmux = <MT6797_GPIO31__FUNC_CMMCLK1>;
		};

		pins-ctrl {
			pinmux = <MT6797_GPIO33__FUNC_GPIO33>,
				 <MT6797_GPIO29__FUNC_GPIO29>;
		};
	};

	microsd_mmc1_pins: microsd-mmc1-pins {
		pins-card-detect {
			pinmux = <MT6797_GPIO67__FUNC_GPIO67>;
			input-enable;
			input-schmitt-enable;
			bias-disable;
		};

		pins-cmd-dat {
			pinmux = <MT6797_GPIO129__FUNC_MSDC1_CMD>,
				 <MT6797_GPIO130__FUNC_MSDC1_DAT0>,
				 <MT6797_GPIO131__FUNC_MSDC1_DAT1>,
				 <MT6797_GPIO132__FUNC_MSDC1_DAT2>,
				 <MT6797_GPIO133__FUNC_MSDC1_DAT3>;
		};

		pins-clk {
			pinmux = <MT6797_GPIO134__FUNC_MSDC1_CLK>;
		};
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_gemini_pins>;
	status = "okay";
};

&mmc0 {
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins_default>;
	pinctrl-1 = <&mmc0_pins_default>;
	bus-width = <8>;
	max-frequency = <52000000>;
	cap-mmc-highspeed;
	vmmc-supply = <&mt6351_vemc_reg>;
	vqmmc-supply = <&mt6351_vio18_reg>;
	non-removable;
	no-sd;
	no-sdio;
	status = "okay";
};

&i2c6 {
	compatible = "mediatek,mt6797-idvfs-i2c";
	access-controllers = <&dvfsp_handoff>;
	clock-frequency = <3400000>;
	mediatek,use-push-pull;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c6_pins_a>;
	status = "okay";

	da9214: regulator@68 {
		compatible = "dlg,da9214-legacy";
		reg = <0x68>, <0x69>;
		reg-names = "primary", "page2";
		mediatek,boot-watchdog = <&watchdog>;
		status = "okay";

		regulators {
			/*
			 * Vproc of both Cortex-A53 clusters and of the CCI.
			 * The coupler preserves the inherited voltage until CCI
			 * owns a verified vote, then coordinates CPU/SRAM changes.
			 */
			da9214_bucka: BUCKA {
				regulator-name = "vproc-little";
				regulator-min-microvolt = <770000>;
				regulator-max-microvolt = <1200000>;
				regulator-coupled-with = <&cpu_sram>;
				regulator-coupled-max-spread = <300000>;
				regulator-always-on;
				status = "okay";
			};

			da9214_buckb: BUCKB {
				regulator-name = "vproc-big";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <1200000>;
				status = "okay";
			};
		};
	};
};

&a72_power {
	clocks = <&cpuclk CLK_MCU_MP2>;
	clock-names = "mp2";
	sram-big-supply = <&vsram_big>;
	vproc-big-supply = <&da9214_buckb>;
	status = "okay";
};

&dvfsp_handoff {
	status = "okay";
	nvmem-cells = <&mt6797_ptp_calibration>,
		<&mt6797_cpu_efuse_identity>;
	nvmem-cell-names = "ptp-calibration-data", "cpu-efuse-identity";
};

&i2c7 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c7_pins_a>;
	status = "okay";

	/*
	 * Live Gemian identifies the external GPU buck as RT5735 at 0x1c.
	 * The power-domain owner sequences this rail before enabling the GPU.
	 * The measured ramp rate is 32000 uV/us.
	 */
	rt5735_vgpu: regulator@1c {
		compatible = "richtek,rt5735";
		reg = <0x1c>;
		regulator-name = "vgpu";
		regulator-min-microvolt = <600000>;
		regulator-max-microvolt = <1393750>;
		regulator-enable-ramp-delay = <350>;
		status = "okay";
		regulator-ramp-delay = <32000>;
	};
};

&i2c1 {
	/*
	 * The sensor bus.  The vendor board DT runs it at 400 kHz and the vendor
	 * DWS lists the IMU and the ambient light/proximity sensor on channel 1.
	 */
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pins_a>;
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	/* No interrupt is routed by the retained board description. */
	typec@25 {
		compatible = "onsemi,fusb301";
		reg = <0x25>;

		connector {
			compatible = "usb-c-connector";
			label = "Gemini left USB-C";
			power-role = "sink";
			data-role = "device";
			typec-power-opmode = "default";
			pd-disable;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					left_usb_hs: endpoint {
						remote-endpoint = <&ssusb_role>;
					};
				};
			};
		};
	};

	/*
	 * The vendor driver forces the BMI160 client to 0x69 (SDO high) and
	 * reads chip ID 0xd1 there.  No interrupt is described: no vendor
	 * source ties INT1 or INT2 to a SoC pin, so the driver polls.  The
	 * vendor "direction 7" remaps (x, y, z) to (-y, -x, -z) for both the
	 * accelerometer and the gyroscope.
	 */
	imu@69 {
		compatible = "bosch,bmi160";
		reg = <0x69>;
		mount-matrix = "0", "-1", "0",
			       "-1", "0", "0",
			       "0", "0", "-1";
	};

	/*
	 * Sensortek STK3x1x ambient light and proximity sensor (vendor PID
	 * 0x11, which the driver accepts as an unknown ID), interrupt on
	 * GPIO88/EINT11, active low.
	 */
	light-sensor@48 {
		compatible = "sensortek,stk3310";
		reg = <0x48>;
		interrupt-parent = <&pio>;
		interrupts = <11 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&light_sensor_pins>;
	};

	lcd_bias: regulator@3e {
		compatible = "mediatek,i2c_lcd_bias";
		reg = <0x3e>;

		outp: outp {
			regulator-name = "outp";
			enable-gpios = <&pio 60 GPIO_ACTIVE_HIGH>;
		};

		outn: outn {
			regulator-name = "outn";
			enable-gpios = <&pio 251 GPIO_ACTIVE_HIGH>;
		};
	};
};

&i2c3 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3_pins_a>;
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	/*
	 * Lid LEDs. The five RGB blocks of the lid array are numbered 1 to 5
	 * from one end to the other; their outputs follow the Planet vendor
	 * driver (block 2 is LED13-15) and the Gemian LED daemon. LED16-18
	 * are a further RGB indicator and LED19/LED20 a red and a blue
	 * indicator. All outputs are limited to the lowest current step,
	 * which is what both the vendor driver and Gemian use by default.
	 */
	led-controller@2c {
		compatible = "awinic,aw9120";
		reg = <0x2c>;
		#address-cells = <1>;
		#size-cells = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&aw9120_pins>;
		enable-gpios = <&pio 245 GPIO_ACTIVE_HIGH>;

		multi-led-1 {
			color = <LED_COLOR_ID_RGB>;
			function = LED_FUNCTION_INDICATOR;
			function-enumerator = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			led@0 {
				reg = <0>;
				color = <LED_COLOR_ID_RED>;
				led-max-microamp = <3500>;
			};

			led@1 {
				reg = <1>;
				color = <LED_COLOR_ID_GREEN>;
				led-max-microamp = <3500>;
			};

			led@2 {
				reg = <2>;
				color = <LED_COLOR_ID_BLUE>;
				led-max-microamp = <3500>;
			};
		};

		multi-led-2 {
			color = <LED_COLOR_ID_RGB>;
			function = LED_FUNCTION_INDICATOR;
			function-enumerator = <2>;
			#address-cells = <1>;
			#size-cells = <0>;

			led@c {
				reg = <12>;
				color = <LED_COLOR_ID_RED>;
				led-max-microamp = <3500>;
			};

			led@d {
				reg = <13>;
				color = <LED_COLOR_ID_GREEN>;
				led-max-microamp = <3500>;
			};

			led@e {
				reg = <14>;
				color = <LED_COLOR_ID_BLUE>;
				led-max-microamp = <3500>;
			};
		};

		multi-led-3 {
			color = <LED_COLOR_ID_RGB>;
			function = LED_FUNCTION_INDICATOR;
			function-enumerator = <3>;
			#address-cells = <1>;
			#size-cells = <0>;

			led@3 {
				reg = <3>;
				color = <LED_COLOR_ID_RED>;
				led-max-microamp = <3500>;
			};

			led@4 {
				reg = <4>;
				color = <LED_COLOR_ID_GREEN>;
				led-max-microamp = <3500>;
			};

			led@5 {
				reg = <5>;
				color = <LED_COLOR_ID_BLUE>;
				led-max-microamp = <3500>;
			};
		};

		multi-led-4 {
			color = <LED_COLOR_ID_RGB>;
			function = LED_FUNCTION_INDICATOR;
			function-enumerator = <4>;
			#address-cells = <1>;
			#size-cells = <0>;

			led@6 {
				reg = <6>;
				color = <LED_COLOR_ID_RED>;
				led-max-microamp = <3500>;
			};

			led@7 {
				reg = <7>;
				color = <LED_COLOR_ID_GREEN>;
				led-max-microamp = <3500>;
			};

			led@8 {
				reg = <8>;
				color = <LED_COLOR_ID_BLUE>;
				led-max-microamp = <3500>;
			};
		};

		multi-led-5 {
			color = <LED_COLOR_ID_RGB>;
			function = LED_FUNCTION_INDICATOR;
			function-enumerator = <5>;
			#address-cells = <1>;
			#size-cells = <0>;

			led@9 {
				reg = <9>;
				color = <LED_COLOR_ID_RED>;
				led-max-microamp = <3500>;
			};

			led@a {
				reg = <10>;
				color = <LED_COLOR_ID_GREEN>;
				led-max-microamp = <3500>;
			};

			led@b {
				reg = <11>;
				color = <LED_COLOR_ID_BLUE>;
				led-max-microamp = <3500>;
			};
		};

		multi-led-6 {
			color = <LED_COLOR_ID_RGB>;
			function = LED_FUNCTION_INDICATOR;
			function-enumerator = <6>;
			#address-cells = <1>;
			#size-cells = <0>;

			led@f {
				reg = <15>;
				color = <LED_COLOR_ID_RED>;
				led-max-microamp = <3500>;
			};

			led@10 {
				reg = <16>;
				color = <LED_COLOR_ID_GREEN>;
				led-max-microamp = <3500>;
			};

			led@11 {
				reg = <17>;
				color = <LED_COLOR_ID_BLUE>;
				led-max-microamp = <3500>;
			};
		};

		led@12 {
			reg = <18>;
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_INDICATOR;
			function-enumerator = <7>;
			led-max-microamp = <3500>;
		};

		led@13 {
			reg = <19>;
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_INDICATOR;
			function-enumerator = <7>;
			led-max-microamp = <3500>;
		};
	};

	camera_sub: camera@20 {
		compatible = "hynix,hi556";
		reg = <0x20>;
		pinctrl-names = "default";
		pinctrl-0 = <&camera_sub_pins>;
		clocks = <&seninf_mclk 1>;
		assigned-clocks = <&seninf_mclk 1>;
		assigned-clock-rates = <24000000>;
		dovdd-supply = <&mt6351_vcamio_reg>;
		avdd-supply = <&mt6351_vcama_reg>;
		dvdd-supply = <&mt6351_vcamd_reg>;
		reset-gpios = <&pio 33 GPIO_ACTIVE_LOW>;
		powerdown-gpios = <&pio 29 GPIO_ACTIVE_LOW>;

		port {
			endpoint {
				data-lanes = <1 2>;
			};
		};
	};
};

&i2c4 {
	/*
	 * The Gemini vendor DT and a filtered vendor dmesg capture establish the
	 * NT36772 at 0x62 and GPIO85/EINT8 with a rising edge.  CAP_TOUCH_VDD maps
	 * to MT6351 VLDO28, a fixed 2.8 V rail, but the current MT6351 provider is
	 * dynamically registered and has no board-DT phandle.  More importantly,
	 * GPIO68 reset polarity and timing have not been established. Linux uses
	 * the already-powered controller without claiming GPIO68 or VLDO28.
	 */
	pinctrl-names = "default";
	pinctrl-0 = <&i2c4_pins_a>;
	status = "okay";

	touchscreen: touchscreen@62 {
		compatible = "novatek,nt36xxx";
		reg = <0x62>;
		interrupt-parent = <&pio>;
		interrupts = <8 IRQ_TYPE_EDGE_RISING>;
		pinctrl-names = "default";
		pinctrl-0 = <&touchscreen_irq_pins>;
		/*
		 * The controller reports the panel's native portrait frame
		 * (1080x2160, the same frame as the DSI mode) rotated by 180
		 * degrees.  Undo that here; display rotation stays the
		 * compositor's job, and it rotates touch with the output.
		 */
		touchscreen-inverted-x;
		touchscreen-inverted-y;
		status = "okay";
		panel = <&gemini_panel>;
		/*
		 * The panel holds the controller in reset until it is prepared, so
		 * the driver cannot read the firmware's range at probe.  This is the
		 * range the firmware reports (0x78 block), in the panel's native
		 * portrait frame; the driver checks it on first start.
		 */
		touchscreen-size-x = <1080>;
		touchscreen-size-y = <2160>;
		/delete-property/ novatek,identity-only;
	};
};

&watchdog {
	/delete-property/ interrupts;
};

&i2c5 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c5_pins_a>;
	/* The retained successful AW9523/matrix experiment used 400 kHz. */
	clock-frequency = <400000>;
	status = "okay";

	aw9523: gpio-expander@5b {
		compatible = "awinic,aw9523-pinctrl";
		reg = <0x5b>;
		pinctrl-names = "default";
		pinctrl-0 = <&keyboard_soc_pins>;
		gpio-controller;
		#gpio-cells = <2>;
		gpio-ranges = <&aw9523 0 0 16>;
		/*
		 * GPIO87/EINT10 is retained in keyboard_soc_pins as a hardware
		 * fact, but this base candidate does not publish an AW9523 IRQ
		 * domain. The reviewed keyboard path polls; an IRQ experiment must
		 * add and validate the complete parent/domain contract explicitly.
		 */
		reset-gpios = <&pio 58 GPIO_ACTIVE_HIGH>;
		/*
		 * The base candidate intentionally does not publish the expander's
		 * untested parent interrupt domain. gpio-matrix-keypad selects polling
		 * below, so it will not request row GPIO interrupts either.
		 */
		status = "okay";

		keyboard_matrix_row_pins: keyboard-matrix-row-pins {
			pins = "gpio0", "gpio1", "gpio2", "gpio3",
			       "gpio4", "gpio5", "gpio6", "gpio7";
			function = "gpio";
			bias-pull-up;
			drive-open-drain;
			input-enable;
		};

		keyboard_matrix_col_pins: keyboard-matrix-col-pins {
			pins = "gpio8", "gpio9", "gpio10", "gpio11",
			       "gpio12", "gpio13", "gpio14";
			function = "gpio";
			input-disable;
			output-low;
		};
	};
};

/*
 * The left USB-C connector uses the MTU3 device controller. Both PHYs
 * remain powered for USB2 fallback. Host role switching is not enabled yet.
 */
&u2port0 {
	clocks = <&clk26m>;
	phy-supply = <&mt6351_va10_reg>;
	mediatek,force-b-session-valid;
	status = "okay";
};

&u3port0 {
	clocks = <&clk26m>;
	phy-supply = <&mt6351_va10_reg>;
	nvmem-cells = <&mt6797_usb3_intr>, <&mt6797_usb3_rx_imp>,
		     <&mt6797_usb3_tx_imp>;
	nvmem-cell-names = "intr", "rx_imp", "tx_imp";
	status = "okay";
};

&ssusb {
	assigned-clocks = <&topckgen CLK_TOP_MUX_SSUSB_TOP_SYS>;
	assigned-clock-parents = <&topckgen CLK_TOP_UNIVPLL3_D2>;
	phys = <&u2port0 PHY_TYPE_USB2>, <&u3port0 PHY_TYPE_USB3>;
	dr_mode = "peripheral";
	usb-role-switch;
	maximum-speed = "super-speed";
	vusb33-supply = <&mt6351_vusb33_reg>;
	status = "okay";

	port {
		ssusb_role: endpoint {
			remote-endpoint = <&left_usb_hs>;
		};
	};
};

&thermal {
	nvmem-cells = <&mt6797_thermal_calibration>;
	nvmem-cell-names = "calibration-data";
	status = "okay";
};

&i2c0 {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pins_a>;
	status = "okay";

	/* FAN49101 is populated, but keep the regulator and consumer disabled. */
	fan49101: regulator@70 {
		compatible = "onsemi,fan49101";
		reg = <0x70>;
		status = "disabled";

		regulators {
			fan49101_vout: vout {
				regulator-name = "fan49101-vout";
				regulator-min-microvolt = <603000>;
				regulator-max-microvolt = <1413000>;
			};
		};
	};

	fusb301a: typec@25 {
		compatible = "onsemi,fusb301a";
		reg = <0x25>;
		interrupt-parent = <&pio>;
		interrupts = <3 IRQ_TYPE_EDGE_BOTH>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb11_fusb301a_pins>;
		vbus-supply = <&usb11_vbus>;

		connector {
			compatible = "usb-c-connector";
			label = "Gemini right USB-C";
			power-role = "source";
			data-role = "host";
			typec-power-opmode = "default";
			pd-disable;
		};
	};

	battery_charger: charger@6b {
		compatible = "ti,bq25896", "ti,bq25890";
		reg = <0x6b>;
		linux,skip-reset;
		ti,status-poll-interval-ms = <5000>;
		ti,battery-regulation-voltage = <4352000>;
		ti,charge-current = <2048000>;
		ti,termination-current = <192000>;
		ti,precharge-current = <128000>;
		ti,minimum-sys-voltage = <3500000>;
		ti,boost-voltage = <4998000>;
		ti,boost-max-current = <1300000>;
		ti,thermal-regulation-threshold = <120>;
		ti,ibatcomp-micro-ohms = <80000>;
		ti,ibatcomp-clamp-microvolt = <224000>;
		ti,use-ilim-pin;
	};
};

/* The async power domain owns VGPU; Panfrost must not claim it twice. */
&gpu {
	/delete-property/ mali-supply;
	nvmem-cells = <&mt6797_cpu_efuse_identity>;
	nvmem-cell-names = "gpu-efuse";
	operating-points-v2 = <&gpu_opp_table>;
	#cooling-cells = <2>;
	status = "okay";
	mediatek,gemini-gpuldo-owner;
};

/*
 * The display scans out untranslated, from CMA buffers. With the M4U on,
 * translated scanout (OVL0 larb0/0, OVL0_2L larb5/6, RDMA0 larb0/2) stalls
 * intermittently (flip_done timeouts with no M4U fault reported), while the
 * JPEG codec behind the same M4U works. Keep the display off the IOMMU until
 * that is understood.
 */
&ovl0 {
	/delete-property/ iommus;
	status = "okay";
	mediatek,larb = <&larb0>;

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0>;

			gemini_ovl0_in: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&gemini_mmsys_out>;
			};
		};

		port@1 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <1>;

			gemini_ovl0_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&gemini_ovl0_2l_in>;
			};
		};
	};
};

&ovl0_2l {
	/delete-property/ iommus;
	status = "okay";
	mediatek,larb = <&larb5>;

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0>;

			gemini_ovl0_2l_in: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&gemini_ovl0_out>;
			};
		};

		port@1 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <1>;

			gemini_ovl0_2l_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&gemini_color0_in>;
			};
		};
	};
};

&ovl1_2l {
	/delete-property/ iommus;
};

&rdma0 {
	/delete-property/ iommus;
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0>;

			gemini_rdma0_in: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&gemini_dither0_out>;
			};
		};

		port@1 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <1>;

			gemini_rdma0_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&gemini_ufoe_in>;
			};
		};
	};
};

&usb11_tphy {
	status = "okay";
};

&usb11_u2 {
	mediatek,force-a-session-valid;
	status = "okay";
	phy-supply = <&mt6351_vusb33_reg>;
};

&usb11 {
	status = "okay";
};

/*
 * The vendor pwm_config is all zero: clock source 0 and divider 0.  The
 * MT6797 LK writes that source into the topckgen PWM mux (CLK_CFG_1 bits
 * 1:0), selecting clk26m, and programs a 1024-count period: 39385 ns, or
 * 25.4 kHz.  Keep that clock explicitly rather than inheriting it.
 */
&disp_pwm {
	pinctrl-names = "default";
	pinctrl-0 = <&disp_pwm_pins>;
	assigned-clocks = <&topckgen CLK_TOP_MUX_PWM>;
	assigned-clock-parents = <&clk26m>;
	status = "okay";
};

/*
 * Primary path as in the vendor driver (ddp_path.c): OVL0 -> OVL0_2L ->
 * COLOR0 -> ... -> DSI0.  OVL0 is the engine LK leaves scanning out its
 * splash; owning it here reprograms it on the first modeset instead of
 * leaving it fetching the LK framebuffer.  OVL0 feeds OVL0_2L's background
 * input directly (no mmsys mux).
 *
 * Without the M4U the display uses physically contiguous DRM buffers, and no
 * IOMMU attach links the OVLs to their SMI larb, so each OVL names its larb
 * for runtime PM: OVL0 fetches through larb0, OVL0_2L through larb5 (vendor
 * M4U_PORT_DISP_OVL0 / M4U_PORT_DISP_2L_OVL0_LARB5).
 */

&mipi_tx0 {
	status = "okay";
};

&smi_common {
	status = "okay";
};

&larb0 {
	status = "okay";
};

&larb5 {
	status = "okay";
};

&color0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0>;

			gemini_color0_in: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&gemini_ovl0_2l_out>;
			};
		};

		port@1 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <1>;

			gemini_color0_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&gemini_ccorr0_in>;
			};
		};
	};
};

&ccorr0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0>;

			gemini_ccorr0_in: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&gemini_color0_out>;
			};
		};

		port@1 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <1>;

			gemini_ccorr0_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&gemini_aal0_in>;
			};
		};
	};
};

&aal0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0>;

			gemini_aal0_in: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&gemini_ccorr0_out>;
			};
		};

		port@1 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <1>;

			gemini_aal0_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&gemini_gamma0_in>;
