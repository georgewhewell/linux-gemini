&dither0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0>;

			gemini_dither0_in: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&gemini_od0_out>;
