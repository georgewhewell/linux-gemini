config VIDEO_MTK_MT6797_CAMSV_CORE
	tristate

config VIDEO_MTK_MT6797_CAMSV
	tristate "MediaTek MT6797 CAMSV capture engine"
	depends on ARCH_MEDIATEK || COMPILE_TEST
	depends on VIDEO_DEV
	depends on OF
	select MEDIA_CONTROLLER
	select V4L2_ASYNC
	select V4L2_FWNODE
	select VIDEOBUF2_DMA_CONTIG
	select VIDEO_MTK_MT6797_CAMSV_CORE
	help
	  Build the V4L2 capture driver for the first MT6797 CAMSV engine.
	  It exposes the source-recovered CAMSV0 RAW10 packed path through a
	  standard media-controller graph and videobuf2 DMA queue. Other engines,
	  formats and dimensions remain unavailable until independently proven.
	  This does not provide an ISP or establish a particular board topology.

config VIDEO_MTK_MT6797_CAMSV_KUNIT_TEST
	tristate "KUnit tests for the MT6797 CAMSV core" if !KUNIT_ALL_TESTS
	depends on KUNIT
	select VIDEO_MTK_MT6797_CAMSV_CORE
	default KUNIT_ALL_TESTS
	help
	  Test MT6797 CAMSV format validation and register-plan construction.
	  The tests verify the one supported packed RAW10 format, exact register
	  values, and fail-closed rejection of incomplete plans. They do not
	  access hardware and can run on any KUnit-capable architecture.
