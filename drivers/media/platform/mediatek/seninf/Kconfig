config VIDEO_MTK_MT6797_SENINF_CORE
	tristate

config VIDEO_MTK_MT6797_SENINF
	tristate "MediaTek MT6797 SENINF receiver core"
	depends on ARCH_MEDIATEK || COMPILE_TEST
	depends on VIDEO_DEV
	depends on OF
	depends on NVMEM
	select MEDIA_CONTROLLER
	select V4L2_ASYNC
	select V4L2_FWNODE
	select VIDEO_MTK_MT6797_SENINF_CORE
	help
	  Build the V4L2 bridge for the MT6797 sensor interface and CSI-2
	  receiver. The driver supports the source-recovered NCSI2 route at
	  2592x1944, with two data lanes and a 440 MHz link. Board topology,
	  unestablished routes and other modes fail closed.

config VIDEO_MTK_MT6797_SENINF_KUNIT_TEST
	tristate "KUnit tests for the MT6797 SENINF core" if !KUNIT_ALL_TESTS
	depends on KUNIT
	select VIDEO_MTK_MT6797_SENINF_CORE
	default KUNIT_ALL_TESTS
	help
	  Test MT6797 SENINF resource, endpoint, format and register-plan
	  helpers. The tests verify programming and rollback with fake register
	  banks. They never touch hardware and can run on any KUnit-capable
	  architecture.
