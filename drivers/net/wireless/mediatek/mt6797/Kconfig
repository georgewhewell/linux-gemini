config MT6797_WIFI_AHB_HIF
	tristate "MediaTek MT6797 Wi-Fi AHB transport library"
	depends on ARCH_MEDIATEK || COMPILE_TEST
	depends on HAS_IOMEM
	help
	  Build the low-level, PIO-only transport library for the SDIO-like
	  Wi-Fi host interface found in the MT6797 connectivity subsystem.

	  This library has no bus driver and no device registration.  Enabling
	  it alone does not bind a device or access hardware.

	  If unsure, say N.

config MT6797_WIFI_AHB_HIF_KUNIT_TEST
	bool "KUnit tests for the MT6797 Wi-Fi AHB transport" if !KUNIT_ALL_TESTS
	depends on KUNIT
	depends on MT6797_WIFI_AHB_HIF
	default KUNIT_ALL_TESTS
	help
	  Run tests for command encoding and bounded transfer planning in the
	  MT6797 Wi-Fi AHB transport library.  The tests do not require MT6797
	  hardware and do not perform MMIO accesses.

	  If unsure, say N.

config MTK_MT6797_WIFI
	tristate "MediaTek MT6797 integrated GEN3 WLAN endpoint"
	depends on OF && MTK_MT6797_CONSYS_INVENTORY
	select CRYPTO_SHA256
	select FW_LOADER
	select MT6797_WIFI_AHB_HIF
	help
	  Build the platform endpoint for the MT6797 integrated GEN3 WLAN host
	  interface. The driver acquires the aggregate's exclusive Wi-Fi lease,
	  downloads the exact SHA-256-pinned divided firmware over the bounded
	  AHB PIO and temporary shared-EMI paths, waits for firmware READY, then
	  performs one bounded NIC capability command/event exchange and sends the
	  post-capability basic configuration with all checksum offload disabled.

	  IRQ283 is requested once with IRQF_NO_AUTOEN. After configuration, the
	  driver establishes persistent ownership of the ordinary HIF interrupt
	  format and gates. Runtime interrupts use read-clear acknowledgment, TX
	  release accounting, and a bounded ordinary-mode RX pump. Valid firmware
	  events and frame classes are decoded and counted but not yet delivered to
	  a radio consumer. Any malformed, overflowing, timed-out, or failed pump is
	  fenced and stopped asynchronously. No wiphy or network device is
	  registered. The Device Tree node is disabled by default, so enabling this
	  option alone performs no hardware access.

config MTK_MT6797_WIFI_KUNIT_TEST
	bool "KUnit tests for the MT6797 WLAN firmware boundary" if !KUNIT_ALL_TESTS
	depends on KUNIT
	depends on MTK_MT6797_WIFI=y
	default KUNIT_ALL_TESTS
	help
	  Exercise exact divided-header parsing, boot and NIC-capability transaction
	  ordering, bounded runtime command/event and RX/TX descriptor codecs, basic
	  configuration and persistent HIF lifecycle, rollback, and terminal fencing
	  plus strict RX group-3 and beacon/probe metadata parsing using memory-only
	  fixtures. No firmware is requested and no MMIO,
	  interrupt, regulator, CONSYS, or Wi-Fi hardware is accessed.
	  It also checks copied, generation-scoped selection of an explicitly named
	  BSSID and SSID from validated beacon/probe metadata, including refresh and
	  expiry behavior.
	  The suite also covers the pure caller-serialized AIS station and
	  WLAN-table resource ledger, including atomic allocation rollback and
	  stale-handle rejection, plus caller-driven AIS transaction ordering,
	  timeout arbitration, reverse teardown, and terminal fencing.
