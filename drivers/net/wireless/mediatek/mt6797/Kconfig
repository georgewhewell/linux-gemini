config MT6797_WIFI_AHB_HIF
	tristate "MediaTek MT6797 Wi-Fi AHB transport library"
	depends on ARCH_MEDIATEK || COMPILE_TEST
	depends on HAS_IOMEM
	help
	  Build the low-level, PIO-only transport library for the SDIO-like
	  Wi-Fi host interface found in the MT6797 connectivity subsystem.

	  This library has no bus driver and no device registration.  Enabling
	  it alone does not bind a device or access hardware.

	  If unsure, say N.

config MT6797_WIFI_AHB_HIF_KUNIT_TEST
	bool "KUnit tests for the MT6797 Wi-Fi AHB transport" if !KUNIT_ALL_TESTS
	depends on KUNIT
	depends on MT6797_WIFI_AHB_HIF
	default KUNIT_ALL_TESTS
	help
	  Run tests for command encoding and bounded transfer planning in the
	  MT6797 Wi-Fi AHB transport library.  The tests do not require MT6797
	  hardware and do not perform MMIO accesses.

	  If unsure, say N.

config MTK_MT6797_WIFI
	tristate "MediaTek MT6797 integrated GEN3 WLAN endpoint"
	depends on OF && MTK_MT6797_CONSYS_INVENTORY
	select CRYPTO_SHA256
	select FW_LOADER
	select MT6797_WIFI_AHB_HIF
	help
	  Build the platform endpoint for the MT6797 integrated GEN3 WLAN host
	  interface. The driver acquires the aggregate's exclusive Wi-Fi lease,
	  downloads the exact SHA-256-pinned divided firmware over the bounded
	  AHB PIO and temporary shared-EMI paths, and waits for firmware READY.

	  The driver neither requests nor enables the interrupt and registers no
	  wiphy or network device. The Device Tree node is disabled by default, so
	  enabling this option alone performs no hardware access.

config MTK_MT6797_WIFI_KUNIT_TEST
	bool "KUnit tests for the MT6797 WLAN firmware boundary" if !KUNIT_ALL_TESTS
	depends on KUNIT
	depends on MTK_MT6797_WIFI=y
	default KUNIT_ALL_TESTS
	help
	  Exercise exact divided-header parsing and the boot transaction's ordering,
	  rollback, and terminal fencing with memory-only fixtures. No firmware is
	  requested and no MMIO, interrupt, regulator, CONSYS, or Wi-Fi hardware is
	  accessed.
