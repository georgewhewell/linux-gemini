config MTK_MT6797_MODEM_PROTOCOL
	bool "MediaTek MT6797 modem protocol helpers"
	depends on ARCH_MEDIATEK || COMPILE_TEST
	help
	  Build helpers for the fixed CCCI header, CLDMA descriptor address
	  formats, and ordered boot-control handshake used by the integrated
	  MT6797 modem.  This option does not register a device, access hardware,
	  or start modem firmware.

	  If unsure, say N.

config MTK_MT6797_MD1
	tristate "MediaTek MT6797 MD1 ownership core"
	depends on ARCH_MEDIATEK || COMPILE_TEST
	depends on COMMON_CLK && OF && RESET_CONTROLLER
	select MFD_SYSCON
	select MTK_MT6797_MODEM_PROTOCOL
	help
	  Claim the standard clock, reset, interrupt, MMIO, and reserved-memory
	  resources of the integrated MT6797 MD1 modem.  If the bootloader left
	  MD1 powered and CLDMA/CCIF strictly quiescent, the driver resets the AP
	  CLDMA block and creates a private control-RX ring to receive CCCI HS1.
	  It validates and refills the completed descriptor, then stops at that
	  boundary.  The evidenced UART2 WWAN control port remains gated until
	  HS2 and separately owned queue-1 RX/TX paths exist.

	  This driver does not load or start modem firmware, change modem power
	  state, send runtime data, or access radio hardware.  The DT node is
	  disabled by default.  If unsure, say N.

config MTK_MT6797_MD1_KUNIT_TEST
	bool "KUnit tests for MT6797 MD1 observation" if !KUNIT_ALL_TESTS
	depends on KUNIT
	depends on MTK_MT6797_MD1=y
	default KUNIT_ALL_TESTS
	help
	  Validate fail-closed classification of the two read-only SPM
	  power-status bits and inherited CLDMA/CCIF configuration, plus exact
	  construction and ownership checks for the control receive ring.  The
	  tests cover disagreement, pending CCIF work, foreign rings, invalid DMA
	  addresses, corrupted links, malformed descriptors, refill, CCCI receive
	  sequencing, and the fail-closed UART2 port gate.  They are hardware
	  independent; no modem resources are acquired or accessed.

config MTK_MT6797_MODEM_PROTOCOL_KUNIT_TEST
	bool "KUnit tests for MT6797 modem protocol helpers" if !KUNIT_ALL_TESTS
	depends on KUNIT
	depends on MTK_MT6797_MODEM_PROTOCOL=y
	default KUNIT_ALL_TESTS
	help
	  Run tests for the fixed-width MT6797 CCCI header and for packing
	  36-bit CLDMA addresses into descriptors.  The tests cover exact
	  little-endian representations, round trips, range checking, boot
	  handshake ordering, exception fencing, and preservation of unrelated
	  descriptor bits.
