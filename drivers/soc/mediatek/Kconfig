config MTK_MT6797_WIFI_AHB_W2_NIC_CAPABILITY
	bool "MT6797 WLAN GEN3 W2 vendor-polled NIC-capability proof"
	depends on MTK_MT6797_WIFI_AHB_W1_FIRMWARE_PREFLIGHT=y
	help
	  After the complete W1 firmware start/READY sequence has cleared WHISR and
	  TX release counts, issue the vendor's ordinary CMD_ID_GET_NIC_CAPABILITY
	  query. The command is the exact 124-byte port-1 command (CID 0x80,
	  sequence 1), and its only accepted response is the exact 124-byte port-1
	  EVENT_ID_NIC_CAPABILITY (EID 0x01, sequence 1). As in the vendor's
	  wlanQueryNicCapability() route, the response is polled through WRPLR/WRDR1
	  before device global interrupt delivery is enabled. Any stale RX0 packet is
	  read and discarded with the vendor's bounded port framing while delivery is
	  still disabled; a non-empty port-1 length before the command, a malformed
	  packet, a non-quiescent bounded drain, wrong event, length, sequence, or
	  timeout fails closed.

config MTK_MT6797_WIFI_AHB_W3_SESSION
	bool "MT6797 WLAN GEN3 W3 persistent HIF-session core"
	depends on MTK_MT6797_WIFI_AHB_W2_NIC_CAPABILITY=y
	help
	  Build the hardware-independent lifecycle core required by a future retained
	  MT6797 WLAN HIF owner. It requires that owner to acquire the long-lived
	  CONSYS/HIF session and request a masked Linux IRQ, acknowledges WHISR and
	  accounts TX release state, drains both receive ports, performs the exact W2
	  capability callback, applies basic/MAC configuration, switches WHCR to
	  interrupt read-clear, writes WHLPCR INT_SET, and only then unmasks the host
	  IRQ. Teardown masks host then device IRQ, acknowledges/drains and releases
	  the owner in reverse order.

