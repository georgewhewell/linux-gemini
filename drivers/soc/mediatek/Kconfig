config MTK_MT6797_DVFSP_CLOCK_BACKEND
	bool "MediaTek MT6797 protected CPU clock readback transport"
	depends on ARM64 && ARCH_MEDIATEK && OF && COMMON_CLK
	help
	  Build the disabled-only MCUMIXED/DVFSP transport used to read the
	  MT6797 LL/L/CCI CPU clock window under its documented CSPM hardware
