# MediaTek SoC drivers
#
menu "MediaTek SoC drivers"
	depends on ARCH_MEDIATEK || COMPILE_TEST

config MTK_CMDQ
	tristate "MediaTek CMDQ Support"
	depends on ARCH_MEDIATEK || COMPILE_TEST
	select MAILBOX
	select MTK_CMDQ_MBOX
	select MTK_INFRACFG
	help
	  Say yes here to add support for the MediaTek Command Queue (CMDQ)
	  driver. The CMDQ is used to help read/write registers with critical
	  time limitation, such as updating display configuration during the
	  vblank.

config MTK_DEVAPC
	tristate "Mediatek Device APC Support"
	help
	  Say yes here to enable support for Mediatek Device APC driver.
	  This driver is mainly used to handle the violation which catches
	  unexpected transaction.
	  The violation information is logged for further analysis or
	  countermeasures.

config MTK_DVFSRC
	tristate "MediaTek DVFSRC Support"
	depends on ARCH_MEDIATEK
	help
	  Say yes here to add support for the MediaTek Dynamic Voltage
	  and Frequency Scaling Resource Collector (DVFSRC): a HW
	  IP found on many MediaTek SoCs, which is responsible for
	  collecting DVFS requests from various SoC IPs, other than
	  software, and performing bandwidth scaling to provide the
	  best achievable performance-per-watt.

config MTK_INFRACFG
	bool "MediaTek INFRACFG Support"
	select REGMAP
	help
	  Say yes here to add support for the MediaTek INFRACFG controller. The
	  INFRACFG controller contains various infrastructure registers not
	  directly associated to any device.

config MTK_STP
	tristate "MediaTek STP codec and WMT/GNSS multiplexer"
	depends on ARCH_MEDIATEK || COMPILE_TEST
	select CRC16
	help
	  Build the hardware-independent codec for MediaTek Serial Transport
	  Protocol (STP) mandatory and full frames, plus a small internal
	  multiplexer for WMT and GNSS payloads. A future byte transport supplies
	  and consumes frames; this option does not probe hardware, load firmware,
	  or expose a userspace ABI.

config MTK_STP_KUNIT_TEST
	bool "KUnit tests for the MediaTek STP codec"
	depends on KUNIT=y
	depends on MTK_STP=y
	help
	  Exercise STP frame vectors, fragmented input, integrity failures, and
	  WMT/GNSS channel isolation without hardware or firmware. This test uses
	  only the transport-neutral codec and can run without a MediaTek device.
	  It does not open a serial link, a BTIF DMA engine, or a firmware image.

config MTK_WMT
	tristate "MediaTek WMT packet codec and transaction fence"
	depends on MTK_STP
	help
	  Build the hardware-independent WMT packet codec and one-at-a-time
	  request/reply matcher.  A future transport owner supplies STP frames and
	  explicitly chooses controller commands.  This option neither probes
	  hardware nor loads firmware or exposes a userspace interface.

config MTK_WMT_KUNIT_TEST
	bool "KUnit tests for the MediaTek WMT transaction layer"
	depends on KUNIT=y
	depends on MTK_WMT=y
	help
	  Exercise strict WMT length/direction validation, exact matching,
	  timeout fencing, cancellation, unsolicited events and fragmented STP
	  delivery without hardware or firmware. This does not send a WMT command,
	  access an STP transport, or instantiate a connectivity device.

config MTK_MT6797_A72_POWER
	bool "MediaTek MT6797 Cortex-A72 power resource observer"
	depends on ARM64 && ARCH_MEDIATEK && OF
	depends on REGULATOR && RESET_CONTROLLER
	select MFD_SYSCON
	help
	  Build the resource observer for the MT6797 Cortex-A72 cluster power
	  path.  It verifies that the external processor regulator, TOPRGU
	  reset, SPM syscon, and MCUCFG resources are available and publishes
	  a read-only snapshot in sysfs.

	  This initial implementation never changes power state and never
	  authorizes CPU_ON.  It is groundwork for a later provider that can
	  reproduce the hardware power sequence.

config MTK_MT6797_CONSYS_INVENTORY
	bool "MediaTek MT6797 CONSYS resource inventory"
	depends on ARM64 && ARCH_MEDIATEK && OF
	depends on RESET_CONTROLLER
	select MTK_MT6797_CONSYS_CORE
	help
	  Build the resource-only inventory driver for the MT6797 connectivity
	  subsystem. It validates Device Tree resource metadata and acquires no
	  active hardware ownership: no MMIO mapping or access, firmware request,
	  power-domain change, or clock, regulator, reset, or interrupt operation.

	  It reuses only the shared-memory geometry validator from the hardware-
	  neutral core; it never enters the core's lifecycle state machine. Keep the
	  Device Tree node disabled until a separate power and transport
	  implementation has been reviewed.

config MTK_MT6797_CONSYS_CORE
	bool "MediaTek MT6797 CONSYS identity transaction core"
	help
	  Build the hardware-neutral identity transaction core for the MT6797
	  connectivity subsystem. It holds reset while it observes the powered
	  subsystem through bounded backend polls, then performs reverse-order
	  cleanup. It includes no hardware backend and cannot map MMIO, release
	  reset, alter AFE state, or load firmware.

	  The inventory driver reuses this core's data-only shared-memory geometry
	  validator but does not instantiate its lifecycle state machine. A future
	  backend must settle the unverified reset and bus-protection sequence before
	  any Device Tree node is enabled.

config MTK_MT6797_CONSYS_CORE_KUNIT_TEST
	tristate "KUnit tests for the MT6797 CONSYS lifecycle core"
	depends on KUNIT=y
	depends on MTK_MT6797_CONSYS_CORE=y
	help
	  Exercise the hardware-free CONSYS identity state machine, timeout
	  bounds, reference counting, and reverse-order cleanup using a fake
	  backend. No Device Tree node, MMIO region, regulator, or clock is used.

	  This is intended for KUnit-compatible test kernels and has no hardware
	  dependency or firmware requirement.

config MTK_MT6797_CONSYS_LIVE
	tristate "MediaTek MT6797 CONSYS bounded identity experiment"
	depends on ARM64 && ARCH_MEDIATEK && OF && PM
	depends on PM_GENERIC_DOMAINS_OF && MTK_SCPSYS
	depends on REGULATOR_MT6351 && RESET_CONTROLLER
	depends on MTK_MT6797_CONSYS_CORE
	select MFD_SYSCON
	help
	  Build the explicitly opt-in MT6797 CONSYS identity experiment. It uses
	  the MT6351 VCN18/VCN28 regulator owner, the MT6797 SCPSYS CONN domain,
	  and the CONMCU reset controller to read chip ID 0x0279 while reset stays
	  asserted. It does not configure AFE, load firmware, or enable a radio.

	  The board node remains disabled and the driver additionally requires
	  mt6797_consys_live.identity_experiment=1 at boot. This is for one
	  recoverable device test only.

config MTK_MT6797_CONSYS_FIRMWARE_PREFLIGHT
	bool "MediaTek MT6797 CONSYS firmware preflight gate"
	depends on MTK_MT6797_CONSYS_CORE
	select CRYPTO_SHA256
	help
	  Build a data-only guard for the MT6797 CONSYS WMT configuration and patch
	  blobs. It accepts only bare firmware names, verifies a caller-supplied
	  SHA-256 digest of every full blob, bounds and parses the documented 28-byte
	  patch header, and requires opaque four-byte address metadata for every
	  patch.

	  It does not request firmware, map shared memory, alter a rail or clock,
	  access BTIF/CONSYS registers, construct a WMT packet, or transmit data.
	  The patch address remains an input from separately evidenced patch
	  discovery; this code never guesses an address from the EMI reservation or
	  a register value.

config MTK_MT6797_CONSYS_FIRMWARE_PREFLIGHT_KUNIT_TEST
	tristate "KUnit tests for the MT6797 CONSYS firmware preflight gate"
	depends on KUNIT=y
	depends on MTK_MT6797_CONSYS_FIRMWARE_PREFLIGHT=y
	help
	  Exercise firmware digest, bare-name, patch-header bounds and parsing,
	  address-presence, and duplicate-sequence rejection with in-memory blobs
	  only. No firmware class request, Device Tree node, MMIO, power resource, or
	  radio is used.
	  This is suitable for test kernels and QEMU, and has no Gemini hardware
	  dependency.

config MTK_MT6797_BTIF_INVENTORY
	tristate "MediaTek MT6797 BTIF/APDMA resource inventory"
	depends on ARM64 && ARCH_MEDIATEK && OF && COMMON_CLK
	help
	  Build a resource-only inventory driver for the MT6797 Bluetooth
	  interface (BTIF) and its APDMA channels. It validates and retains the
	  Device Tree MMIO resource descriptions, clock handles, interrupt
	  numbers, and CONSYS phandle.

	  This driver is intentionally non-functional: it never maps or accesses
	  registers, enables clocks, requests interrupts, allocates DMA, gets a
	  CONSYS power vote, exposes a userspace ABI, or instantiates STP. Keep
	  every future transport consumer disabled until a separately reviewed
	  hardware transaction contract exists.

config MTK_MT6797_BTIF_TRANSPORT
	tristate "Experimental MediaTek MT6797 BTIF/APDMA byte transport"
	depends on ARM64 && ARCH_MEDIATEK && OF && COMMON_CLK
	depends on MTK_STP
	help
	  Build the bounded MT6797 BTIF/APDMA byte transport. It uses the vendor
	  register layout to allocate two 8192-byte DMA32 virtual FIFOs, issue only
	  warm reset and STOP-and-poll operations, and feed received mandatory-mode
	  STP bytes to the hardware-independent parser.

	  The driver has no userspace ABI and does not power CONSYS, release reset,
	  choose pad muxing, load firmware, transmit WMT/HCI/Wi-Fi/FM data, or
	  implement STP full-mode sequencing. Its disabled DT node additionally
	  requires a hand-authored experimental property and the read-only module
	  parameter enable_experimental_transport=1 before it maps registers or
	  enables clocks. This is bring-up infrastructure, not a radio driver.

config MTK_MT6797_BTIF_TRANSPORT_KUNIT_TEST
	bool "KUnit tests for the MT6797 BTIF/APDMA virtual-FIFO helpers"
	depends on KUNIT=y
	depends on MTK_MT6797_BTIF_TRANSPORT=y
	help
	  Exercise virtual-FIFO pointer wrapping, two-segment RX extraction and
	  short-space TX rejection without Device Tree, DMA, clocks, interrupts,
	  firmware or BTIF hardware. The test is suitable for QEMU and validates
	  that malformed pointers never cause the transport to copy or publish
	  uncontrolled ring data.

config MTK_MT6797_DVFSP_HANDOFF
	bool "MediaTek MT6797 stopped DVFSP firmware handoff"
	depends on ARM64 && ARCH_MEDIATEK && OF && COMMON_CLK
	select MFD_SYSCON
	help
	  Build a one-way receiver for an MT6797 CPU-DVFS firmware instance
	  which the preceding software has already stopped and reset. It
	  validates the exact retained CSPM signature observed by the preceding
	  read-only experiment, balances one temporary I2C_APPM clock reference
	  through the common clock framework, verifies the physical gate
	  independently, and repeats the read-only validation after 45 seconds.

	  Any observed mismatch is sticky until reboot. An already-gated
	  initial clock is reported as inconclusive without changing clock
	  state. The receiver never writes CSPM or infracfg directly, starts,
	  resets, pauses, or loads firmware, touches an I2C controller or
	  regulator, or exposes a writable userspace control.

	  This option does not implement per-transfer DVFSP coordination and
	  does not authorize I2C6 by itself. Keep every dependent consumer
	  disabled until a separate experiment establishes the handoff.

	  This option is for bounded Gemini PDA bring-up experiments only.

config MTK_MT6797_DVFSP_RESOURCE_OWNER
	bool "MediaTek MT6797 DVFSP resource-only owner"
	depends on ARM64 && ARCH_MEDIATEK && OF
	depends on MTK_MT6797_DVFSP_HANDOFF
	help
	  Bind only the MT6797 DVFSP resource-lifetime owner. The provider
	  resolves four Device Tree resources, retains their device references,
	  and exposes no readback, hardware operation, firmware call, secure
	  service, clock or regulator operation, state-owner registration, or
	  CPU admission. Keep its Device Tree node disabled until a calibrated
	  provider contract exists.

config MTK_MT6797_DVFSP_OWNER_KUNIT_TEST
	bool "KUnit tests for the MT6797 DVFSP resource owner"
	depends on KUNIT=y
	depends on MTK_MT6797_DVFSP_RESOURCE_OWNER
	help
	  Exercise the hardware-free lifecycle and arbitration contract of the
	  MT6797 DVFSP resource owner. The fixture uses fake device references
	  and performs no hardware, firmware, provider, or CPU operation.

config MTK_MT6797_DVFSP_PROVIDER_KUNIT_TEST
	bool "KUnit tests for the MT6797 calibrated provider bridge"
	depends on KUNIT=y
	depends on MTK_MT6797_DVFSP_RESOURCE_OWNER
	help
	  Exercise the hardware-free source binding and exit contract of the
	  dormant MT6797 calibrated provider.

config MTK_MT6797_DVFSP_VENDOR_OWNER
	bool "MediaTek MT6797 cooperative vendor owner adapter"
	depends on ARM64 && ARCH_MEDIATEK && OF
	depends on MTK_MT6797_DVFSP_RESOURCE_OWNER
	help
	  Compose explicit vendor identity, PPM, live-state, and calibration
	  callbacks around the dormant calibrated provider. This adapter does
	  not call single-slot vendor registration setters, register a handoff
	  owner, perform hardware or firmware operations, or admit a CPU. The
	  vendor-aware driver must supply callbacks that preserve existing
	  policy writers and one transition generation.

config MTK_MT6797_DVFSP_VENDOR_OWNER_KUNIT_TEST
	bool "KUnit tests for the MT6797 cooperative vendor owner adapter"
	depends on KUNIT=y
	depends on MTK_MT6797_DVFSP_VENDOR_OWNER
	help
	  Exercise the hardware-free cooperative callback binding and unbind
	  lifecycle. The fixture invokes no vendor callback or registration API.

config MTK_MT6797_DVFSP_VENDOR_PROVIDER_BRIDGE_KUNIT_TEST
	bool "KUnit tests for the MT6797 vendor provider field bridge"
	depends on KUNIT=y
	depends on MTK_MT6797_DVFSP_VENDOR_OWNER
	help
	  Exercise the hardware-free vendor-to-provider field and identity mapping.
	  The bridge retains raw EEM/CSPM values and reports unsupported provider
	  conversions explicitly; it never registers a provider or touches hardware.

config MTK_MT6797_DVFSP_VENDOR_WRITER
	bool "MediaTek MT6797 vendor writer transition owner"
	depends on ARM64 && ARCH_MEDIATEK && OF
	depends on MTK_MT6797_DVFSP_VENDOR_OWNER
	help
	  Provide one explicit transition mutex and monotonic generation for a
	  vendor-aware writer that chains its existing PTP, voltage, and PPM
	  callback slots. The integration must supply provenance and must call
	  begin/commit or begin/abort around its existing writer path.

config MTK_MT6797_DVFSP_VENDOR_WRITER_KUNIT_TEST
	bool "KUnit tests for the MT6797 vendor writer transition owner"
	depends on KUNIT=y
	depends on MTK_MT6797_DVFSP_VENDOR_WRITER
	help
	  Exercise generation, abort, overflow, and provenance validation using
	  fake callbacks and a fake mutex. No vendor callback or registration API
	  is invoked.

config MTK_MT6797_DVFSP_VENDOR_WRITER_BRIDGE
	bool "MediaTek MT6797 vendor writer owner bridge"
	depends on ARM64 && ARCH_MEDIATEK && OF
	depends on MTK_MT6797_DVFSP_VENDOR_WRITER
	help
	  Export the exact callback table consumed by a separately reviewed
	  vendor-side writer binding. The adapter shares the writer's owner,
	  transition handle, mutex, and generation and is dormant by default.

config MTK_MT6797_DVFSP_VENDOR_WRITER_BRIDGE_KUNIT_TEST
	bool "KUnit tests for the MT6797 vendor writer owner bridge"
	depends on KUNIT=y
	depends on MTK_MT6797_DVFSP_VENDOR_WRITER_BRIDGE
	default n

config MTK_MT6797_DVFSP_VENDOR_WRITER_COORDINATOR
	bool "MediaTek MT6797 vendor writer coordinator"
	depends on ARM64 && ARCH_MEDIATEK && OF
	depends on MTK_MT6797_DVFSP_VENDOR_OWNER
	depends on MTK_MT6797_DVFSP_VENDOR_WRITER_BRIDGE
	default n
	help
	  Provide the explicit mainline caller boundary for a vendor writer
	  integration.  The caller must start it before vendor probe and stop it
	  after vendor remove; this option performs no hardware operation.

config MTK_MT6797_DVFSP_STATE_DECODERS
	bool
	default y if MTK_MT6797_DVFSP_HANDOFF || MTK_MT6797_DVFSP_CLOCK_BACKEND
	help
	  Build the pure MT6797 clock and CSPM state conversion helpers when
	  either the handoff source pipeline or the protected-clock transport
	  needs them. This internal gate performs no I/O and does not enable the
	  optional hardware transport.

config MTK_MT6797_DVFSP_CLOCK_BACKEND
	bool "MediaTek MT6797 protected CPU clock readback transport"
	depends on ARM64 && ARCH_MEDIATEK && OF && COMMON_CLK
	help
	  Build the disabled-only MCUMIXED/DVFSP transport used to read the
	  MT6797 LL/L/CCI CPU clock window under its documented CSPM hardware
	  semaphore. The helper has a bounded acquire/release path and turns
	  a timeout or release failure into a sticky fault.

	  This transport does not write a CPU PLL, divider, regulator, or
	  SRAM-LDO; it does not call the secure monitor, load firmware, or
	  register a DVFSP state owner or clock provider. Its Device Tree
	  node is disabled by default and the B-cluster BigiDVFS path remains
	  separate.

config MTK_MT6797_DVFSP_BIGIDVFS_BACKEND
	bool "MediaTek MT6797 BigiDVFS secure readback transport"
	depends on ARM64 && ARCH_MEDIATEK && OF
	help
	  Build the disabled-only BigiDVFS transport that reads the four exact
	  secure register addresses through the documented REG_READ service.
	  The target firmware variant and return contract remain unvalidated;
	  unknown or sign-extended results become a sticky fault.

	  This transport never calls a secure write or a state-changing FID,
	  never derives an OPP or voltage table, and never registers a DVFSP
	  state owner or clock provider. Its Device Tree node is disabled by
	  default.

config MTK_PMIC_WRAP
	tristate "MediaTek PMIC Wrapper Support"
	depends on RESET_CONTROLLER
	depends on OF
	select REGMAP
	help
	  Say yes here to add support for MediaTek PMIC Wrapper found
	  on different MediaTek SoCs. The PMIC wrapper is a proprietary
	  hardware to connect the PMIC.

config MTK_REGULATOR_COUPLER
	bool "MediaTek SoC Regulator Coupler" if COMPILE_TEST
	default ARCH_MEDIATEK
	depends on REGULATOR

config MTK_MMSYS
	tristate "MediaTek MMSYS Support"
	default ARCH_MEDIATEK
	depends on HAS_IOMEM
	depends on MTK_CMDQ || MTK_CMDQ=n
	help
	  Say yes here to add support for the MediaTek Multimedia
	  Subsystem (MMSYS).

config MTK_SVS
	tristate "MediaTek Smart Voltage Scaling(SVS)"
	depends on NVMEM_MTK_EFUSE && NVMEM
	help
	  The Smart Voltage Scaling(SVS) engine is a piece of hardware
	  which has several controllers(banks) for calculating suitable
	  voltage to different power domains(CPU/GPU/CCI) according to
	  chip process corner, temperatures and other factors. Then DVFS
	  driver could apply SVS bank voltage to PMIC/Buck.

config MTK_SOCINFO
	tristate "MediaTek SoC Information"
	default y
	depends on NVMEM_MTK_EFUSE
	select SOC_BUS
	help
	  The MediaTek SoC Information (mtk-socinfo) driver provides
	  information about the SoC to the userspace including the
	  manufacturer name, marketing name and soc name.

endmenu
