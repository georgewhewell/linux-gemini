config MTK_MT6797_DVFSP_STATE_DECODERS
	bool
	default y if MTK_MT6797_DVFSP_HANDOFF || MTK_MT6797_DVFSP_CLOCK_BACKEND
	help
	  Build the pure MT6797 clock and CSPM state conversion helpers when
	  either the handoff source pipeline or the protected-clock transport
	  needs them. This internal gate performs no I/O and does not enable the
	  optional hardware transport.

config MTK_MT6797_DVFSP_CLOCK_BACKEND
	bool "MediaTek MT6797 protected CPU clock readback transport"
	depends on ARM64 && ARCH_MEDIATEK && OF && COMMON_CLK
	help
	  Build the disabled-only MCUMIXED/DVFSP transport used to read the
	  MT6797 LL/L/CCI CPU clock window under its documented CSPM hardware
	  semaphore. The helper has a bounded acquire/release path and turns
	  a timeout or release failure into a sticky fault.

	  This transport does not write a CPU PLL, divider, regulator, or
	  SRAM-LDO; it does not call the secure monitor, load firmware, or
	  register a DVFSP state owner or clock provider. Its Device Tree
	  node is disabled by default and the B-cluster BigiDVFS path remains
	  separate.

config MTK_MT6797_DVFSP_BIGIDVFS_BACKEND
	bool "MediaTek MT6797 BigiDVFS secure readback transport"
	depends on ARM64 && ARCH_MEDIATEK && OF
	help
	  Build the disabled-only BigiDVFS transport that reads the four exact
	  secure register addresses through the documented REG_READ service.
	  The target firmware variant and return contract remain unvalidated;
	  unknown or sign-extended results become a sticky fault.

	  This transport never calls a secure write or a state-changing FID,
	  never derives an OPP or voltage table, and never registers a DVFSP
	  state owner or clock provider. Its Device Tree node is disabled by
	  default.

