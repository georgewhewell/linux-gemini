config PSTORE
	tristate "Persistent store support"
	default n
	help
	   This option enables generic access to platform level
	   persistent storage via "pstore" filesystem that can
	   be mounted as /dev/pstore.  Only useful if you have
	   a platform level driver that registers with pstore to
	   provide the data, so you probably should just go say "Y"
	   (or "M") to a platform specific persistent store driver
	   (e.g. ACPI_APEI on X86) which will select this for you.
	   If you don't have a platform persistent store driver,
	   say N.

config PSTORE_DEFAULT_KMSG_BYTES
	int "Default kernel log storage space" if EXPERT
	depends on PSTORE
	default "10240"
	help
	  Defines default size of pstore kernel log storage.
	  Can be enlarged if needed, not recommended to shrink it.

config PSTORE_COMPRESS
	bool "Pstore compression (deflate)"
	depends on PSTORE
	select ZLIB_INFLATE
	select ZLIB_DEFLATE
	default y
	help
	  Whether pstore records should be compressed before being written to
	  the backing store. This is implemented using the zlib 'deflate'
	  algorithm, using the library implementation instead of using the full
	  blown crypto API. This reduces the risk of secondary oopses or other
	  problems while pstore is recording panic metadata.

config PSTORE_CONSOLE
	bool "Log kernel console messages"
	depends on PSTORE
	help
	  When the option is enabled, pstore will log all kernel
	  messages, even if no oops or panic happened.

config PSTORE_PMSG
	bool "Log user space messages"
	depends on PSTORE
	select RT_MUTEXES
	help
	  When the option is enabled, pstore will export a character
	  interface /dev/pmsg0 to log user space messages. On reboot
	  data can be retrieved from /sys/fs/pstore/pmsg-ramoops-[ID].

	  If unsure, say N.

config PSTORE_FTRACE
	bool "Persistent function tracer"
	depends on PSTORE
	depends on FUNCTION_TRACER
	depends on DEBUG_FS
	help
	  With this option kernel traces function calls into a persistent
	  ram buffer that can be decoded and dumped after reboot through
	  pstore filesystem. It can be used to determine what function
	  was last called before a reset or panic.

	  If unsure, say N.

config PSTORE_RAM
	tristate "Log panic/oops to a RAM buffer"
	depends on PSTORE
	depends on HAS_IOMEM
	select REED_SOLOMON
	select REED_SOLOMON_ENC8
	select REED_SOLOMON_DEC8
	help
	  This enables panic and oops messages to be logged to a circular
	  buffer in RAM where it can be read back at some later point.

	  Note that for historical reasons, the module will be named
	  "ramoops.ko".

	  For more information, see Documentation/admin-guide/ramoops.rst.

config PSTORE_GEMINI_PRE_RAMOOPS_LEDGER
	bool "Gemini pre-ramoops retained stage ledger"
	depends on PSTORE_RAM=y
	depends on ARM64 && ARCH_MEDIATEK && OF
	default n
	help
	  Write four short experiment records into four exact, otherwise unused
	  dmesg zones in the existing Gemini ramoops reservation.  The records
	  distinguish completion of the reserved-memory scan and the early,
	  core, and postcore initcall levels before normal ramoops registration.

	  The writer requires the exact Gemini DT reservation and four valid,
	  empty persistent-RAM headers before its first write.  Any mismatch
	  disarms later stages.  Normal ramoops registration is skipped only on
	  the Gemini while this diagnostic is selected so a subsequent known-good
	  boot can recover the records.

	  This experiment-only option does not access device storage, regulators,
	  CPU admission, timers, or restart controls.  If unsure, say N.

config PSTORE_GEMINI_ARM64_ENTRY_LEDGER
	bool "Gemini arm64 entry retained stage ledger"
	depends on PSTORE_RAM=y
	depends on ARM64 && ARCH_MEDIATEK && OF
	depends on !PSTORE_GEMINI_PRE_RAMOOPS_LEDGER
	default n
	help
	  Write four short experiment records into exact dmesg zones in the
	  existing Gemini ramoops reservation.  Two call-free checkpoints run
	  in the arm64 primary path before the MMU is enabled, followed by one
	  after early ioremap setup and one after the reserved-memory scan.

	  The MMU-off checkpoints accept only EL1 or EL2 with both translation
	  and data caching disabled.  They require the exact four persistent-RAM
	  headers and preserve every boot-path register outside x9 through x15.
	  Later checkpoints accept each earlier slot only when empty or byte-
	  exact.  Every writer commits data before length fields and performs a
	  complete ordered readback.

	  Normal ramoops registration is skipped only on the Gemini while this
	  isolated diagnostic is selected, so a subsequent known-good boot can
	  recover the records.  This option does not access storage, regulators,
	  clocks, I2C, CPU admission, timers, watchdogs, or restart controls.
	  If unsure, say N.

config PSTORE_GEMINI_PROTECTED_READBACK_MANUAL_CONTROL
	bool "Gemini protected-readback writer manual control"
	depends on PSTORE_RAM=y
	depends on ARM64 && ARCH_MEDIATEK && OF
	depends on !MTK_MT6797_DVFSP_CLOCK_BACKEND
	depends on !MTK_MT6797_PROTECTED_READBACK_OBSERVER
	depends on !PSTORE_GEMINI_PRE_RAMOOPS_LEDGER
	depends on !PSTORE_GEMINI_ARM64_ENTRY_LEDGER
	default n
	help
	  Call the exact two-record retained writer once from an isolated late
	  initcall, then report both local full-readback results in dmesg.  This
	  separates the writer from clock-backend registration, platform-device
	  population, and both protected readback transports.

	  The experiment writes at most two short records to its existing owned
	  persistent-RAM slots.  It never retries, clears, or overwrites a
	  nonempty slot and performs no storage, firmware, I2C, regulator, clock,
	  owner, CPU, timer, watchdog, reset, or power operation.  If unsure,
	  say N.

config PSTORE_GEMINI_PROTECTED_READBACK_MANUAL_STAGE_CONTROL
	bool "Gemini manual checkpoint live failure stage"
	depends on PSTORE_GEMINI_PROTECTED_READBACK_MANUAL_CONTROL=y
	default n
	help
	  Expose one live result distinguishing sequence, exact-DT/resource,
	  mapping, prefix/header, write-precondition, metadata-readback, and
	  payload-readback refusal in the isolated manual checkpoint control.

	  This changes no retained write, protected call, clock, I2C, regulator,
	  owner, CPU, storage, timer, retry, reset, or power behavior. If unsure,
	  say N.

config PSTORE_GEMINI_PROTECTED_READBACK_MANUAL_PREFIX_CONTROL
	bool "Gemini manual checkpoint live prefix reason"
	depends on PSTORE_GEMINI_PROTECTED_READBACK_MANUAL_STAGE_CONTROL=y
	default n
	help
	  After the unchanged four-slot prefix predicate refuses the isolated
	  manual checkpoint, snapshot the first rejected header and report its
	  slot index, signature, start, size, and a fixed failure reason.

	  This adds exactly three bounded retained-memory reads after refusal. It
	  changes no predicate, write, protected call, clock, I2C, regulator,
	  owner, CPU, storage, timer, retry, reset, or power behavior. If unsure,
	  say N.

config PSTORE_GEMINI_PROTECTED_READBACK_MANUAL_MAP_CONTROL
	bool "Gemini manual checkpoint ramoops mapping control"
	depends on PSTORE_GEMINI_PROTECTED_READBACK_MANUAL_PREFIX_CONTROL=y
	default n
	help
	  Compare the first rejected header through the ledger's parallel
	  ioremap_wc() view and the read-only mapping model used by ramoops
	  persistent RAM. Report both three-word snapshots and a fixed result.

	  This mode bypasses the prefix predicate and retained writer. It performs
	  at most three reads through each mapping, unmaps both views, and adds no
	  write, ramoops registration, protected call, clock, I2C, regulator,
	  transition owner, CPU, storage, timer, retry, reset, or power operation.
	  If unsure, say N.

config PSTORE_GEMINI_PROTECTED_READBACK_MANUAL_RAW_WRITE_QUALIFICATION
	bool "Gemini manual checkpoint raw-entry write qualification"
	depends on PSTORE_GEMINI_PROTECTED_READBACK_MANUAL_STAGE_CONTROL=y
	depends on !PSTORE_GEMINI_PROTECTED_READBACK_MANUAL_PREFIX_CONTROL
	depends on !PSTORE_GEMINI_PROTECTED_READBACK_MANUAL_MAP_CONTROL
	depends on !PSTORE_GEMINI_PROTECTED_READBACK_RAW_ENTRY_LEDGER
	default n
	help
	  At the isolated serviceability-proven late initcall, require exact
	  all-ones headers in records 171 through 174 and commit only record 173.
	  Write payload, start, and size before the valid signature, then require
	  a complete local readback and report the exact live stage.

	  This mode makes checkpoint one unavailable and adds no second write,
	  clear, retry, normal ramoops registration, protected call, clock,
	  BigiDVFS, transition owner, CPU, storage, reset, or power operation.
	  If unsure, say N.

config PSTORE_GEMINI_PROTECTED_READBACK_FIRST_DMESG_WRITE_QUALIFICATION
	bool "Gemini first dmesg raw-entry write qualification"
	depends on PSTORE_GEMINI_PROTECTED_READBACK_MANUAL_STAGE_CONTROL=y
	depends on !PSTORE_GEMINI_PROTECTED_READBACK_MANUAL_PREFIX_CONTROL
	depends on !PSTORE_GEMINI_PROTECTED_READBACK_MANUAL_MAP_CONTROL
	depends on !PSTORE_GEMINI_PROTECTED_READBACK_MANUAL_RAW_WRITE_QUALIFICATION
	depends on !PSTORE_GEMINI_PROTECTED_READBACK_RAW_ENTRY_LEDGER
	default n
	help
	  At the isolated serviceability-proven late initcall, require the exact
	  all-ones header in first dmesg record 1 at physical 0x44410000 and
	  commit only that record. Write payload, start, and size before the valid
	  signature, then require a complete local readback and report the exact
	  live stage.

	  This mode is an enumeration-position qualification after a record at
	  index 173 proved raw writing and warm retention but remained behind
	  empty earlier dmesg records. It does not use the nonempty console ring.
	  It makes checkpoint one unavailable and adds no second write, clear,
	  retry, normal ramoops registration, protected call, clock, BigiDVFS,
	  transition owner, CPU, storage, reset, or power operation. If unsure,
	  say N.

config PSTORE_GEMINI_PROTECTED_READBACK_RAW_ENTRY_LEDGER
	bool "Gemini protected-readback raw-entry ledger"
	depends on PSTORE_GEMINI_PROTECTED_READBACK_LEDGER=y
	depends on MTK_MT6797_PROTECTED_READBACK_OBSERVER=y
	depends on !PSTORE_GEMINI_PROTECTED_READBACK_MANUAL_CONTROL
	depends on !PSTORE_GEMINI_PROTECTED_READBACK_PROBE_GATE_LEDGER
	depends on !PSTORE_GEMINI_CLOCK_BACKEND_ENTRY_LEDGER
	default n
	help
	  Accept only an exact all-ones header for each not-yet-owned Gemini
	  retained record. Commit payload, start, and size before writing the
	  valid signature last, then fully read back the owned record.

	  This mode preserves the parent's two-record ceiling and one protected
	  clock read between records. It adds no clear, retry, normal ramoops
	  registration, BigiDVFS read, owner, CPU, storage, reset, or power
	  operation. If unsure, say N.

config PSTORE_GEMINI_PROTECTED_CLOCK_FIRST_DMESG_CALL_QUALIFICATION
	bool "Gemini protected-clock first-dmesg call qualification"
	depends on PSTORE_GEMINI_PROTECTED_READBACK_RAW_ENTRY_LEDGER=y
	depends on !PSTORE_GEMINI_CLOCK_BACKEND_FIRST_DMESG_ENTRY_QUALIFICATION
	default n
	help
	  Move the existing clock-only observer's before-call and after-return
	  records from sparse dmesg zones 173 and 174 to consecutive records 1
	  and 2. Retain the qualified all-ones entry-header gate, signature-last
	  commit, full local readback, two-write ceiling, and no-clear/no-retry
	  policy.

	  The observer still makes exactly one protected clock read and zero
	  BigiDVFS reads. This mode adds no caller, transport operation, secure
	  call, owner registration, CPU request, storage, reset, or power action.
	  If unsure, say N.

